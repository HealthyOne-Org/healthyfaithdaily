["אֶת","'et-","H853","HTo","<obj.>"],["בְּנֵי","benei-","H1121","HNcmpc","[the] people of"],["יִשְׂרָאֵל","yisra'el","H3478","HNpl","Israel"],["בְּאֶרֶץ","be'eretz","H776","HR/Ncfsc","in [the] land of"],["כְּנָעַן","kena'an","H3667","HNpl","Canaan"]]}},"people":[{"id":"moses_2108","name":"Moses","also":"","summary":"Drawn (or Egypt. mesu, “son;” hence Rameses, royal son). On the invitation of Pharaoh (Gen. 45:17-25), Jacob and his sons went down into Egypt.","verses":774,"father":"Amram","mother":"Jochebed","v":[1,13,16]},{"id":"israel_682","name":"Israel","also":"","summary":"One who follows on another’s heels; supplanter, (Gen. 25:26; 27:36; Hos. 12:2-4), the second born of the twin sons of Isaac by Rebekah. He was born probably at Lahai-roi, when his father was fifty-nine and Abraham one hundred and fifty-nine years old.","verses":1009,"father":"Isaac","mother":"Rebekah","v":[2,13,29]},{"id":"canaan_914","name":"Canaan","also":"Canaanites, Canaanite","summary":"The fourth son of Ham (Gen. 10:6). His descendants were under a curse in consequence of the transgression of his father (9:22-27). His eldest son, Zidon, was the father of the Sidonians and Phoenicians.","verses":84,"father":"Ham","mother":"","v":[2,29]},{"id":"esau_1216","name":"Esau","also":"Edom, Edomite","summary":"Hairy, Rebekah’s first-born twin son (Gen. 25:25). The name of Edom, “red”, was also given to him from his conduct in connection with the red lentil “pottage” for which he sold his birthright (30, 31).","verses":151,"father":"Isaac","mother":"Rebekah","v":[3]},{"id":"manasseh_1928","name":"Manasseh","also":"Manasses","summary":"The elder of the two sons of Joseph. He and his brother Ephraim were afterwards adopted by Jacob as his own sons (48:1).","verses":109,"father":"Joseph","mother":"Asenath","v":[14,23]},{"id":"reuben_2429","name":"Reuben","also":"","summary":"Behold a son!, the eldest son of Jacob and Leah (Gen. 29:32). His sinful conduct, referred to in Gen. 35:22, brought down upon him his dying father’s malediction (48:4).","verses":70,"father":"Israel","mother":"Leah","v":[14]},{"id":"gad_1262","name":"Gad","also":"","summary":"Jacob’s seventh son, by Zilpah, Leah’s handmaid, and the brother of Asher (Gen. 30:11-13; 46:16, 18).","verses":55,"father":"Israel","mother":"Zilpah","v":[14]},{"id":"joshua_1727","name":"Joshua","also":"Jehoshua, Oshea, Jesus, Jeshua, Hoshea","summary":"Jehovah is his help, or Jehovah the Saviour. The son of Nun, of the tribe of Ephraim, the successor of Moses as the leader of Israel.","verses":189,"father":"Nun","mother":"","v":[17]},{"id":"eleazar_1062","name":"Eleazar","also":"","summary":"The third son of Aaron (Ex. 6:23). His wife, a daughter of Putiel, bore him Phinehas (Ex. 6:25). After the death of Nadab and Abihu (Lev. 10:12; Num. 3:4) he was appointed to the charge of the sanctuary (Num. 3:32).","verses":61,"father":"Aaron","mother":"Elisheba","v":[17]},{"id":"nun_2214","name":"Nun","also":"Non","summary":"Beyond the fact that he was the father of Joshua nothing more is known of him (Ex. 33:11).","verses":30,"father":"Elishama","mother":"","v":[17]},{"id":"judah_1751","name":"Judah","also":"","summary":"Praise, the fourth son of Jacob by Leah.","verses":245,"father":"Israel","mother":"Leah","v":[19]},{"id":"caleb_537","name":"Caleb","also":"","summary":"The son of Jephunneh (Num. 13:6; 32:12; Josh. 14:6, 14). He was one of those whom Moses sent to search the land in the second year after the Exodus.","verses":30,"father":"Jephunneh","mother":"","v":[19]},{"id":"jephunneh_840","name":"Jephunneh","also":"","summary":"The father of Caleb, who was Joshua’s companion in exploring Canaan (Num. 13:6), a Kenezite (Josh. 14:14).","verses":15,"father":"","mother":"","v":[19]},{"id":"simeon_2741","name":"Simeon","also":"","summary":"The second son of Jacob by Leah (Gen. 29:33). He was associated with Levi in the terrible act of vengeance against Hamor and the Shechemites (34:25, 26).","verses":40,"father":"Israel","mother":"Leah","v":[20]},{"id":"ammihud_224","name":"Ammihud","also":"","summary":"Num. 34:20.","verses":1,"father":"","mother":"","v":[20]},{"id":"shemuel_2653","name":"Shemuel","also":"","summary":"The son of Ammihud.","verses":1,"father":"Ammihud","mother":"","v":[20]},{"id":"benjamin_463","name":"Benjamin","also":"Ben-oni","summary":"The younger son of Jacob by Rachel (Gen. 35:18). His birth took place at Ephrath, on the road between Bethel and Bethlehem, at a short distance from the latter place.","verses":157,"father":"Israel","mother":"Rachel","v":[21]},{"id":"chislon_942","name":"Chislon","also":"","summary":"","verses":1,"father":"","mother":"","v":[21]},{"id":"elidad_1103","name":"Elidad","also":"","summary":"Whom God has loved, son of Chislon, and chief of the tribe of Benjamin; one of those who were appointed to divide the Promised Land among the tribes (Num. 34:21).","verses":1,"father":"Chislon","mother":"","v":[21]},{"id":"dan_973","name":"Dan","also":"","summary":"The fifth son of Jacob. His mother was Bilhah, Rachel’s maid (Gen. 30:6, “God hath judged me”, Heb. dananni).","verses":63,"father":"Israel","mother":"Bilhah","v":[22]},{"id":"bukki_522","name":"Bukki","also":"","summary":"Bukki is referred to in  1 Chronicles and Ezra as the son of the High Priest Abishua, a priest fifth in descent in the line of Eleazar.","verses":1,"father":"Jogli","mother":"","v":[22]},{"id":"jogli_1663","name":"Jogli","also":"","summary":"","verses":1,"father":"","mother":"","v":[22]},{"id":"joseph_1710","name":"Joseph","also":"Zaphnath-paaneah","summary":"The elder of the two sons of Jacob by Rachel (Gen. 30:23, 24), who, on the occasion of his birth, said, “God hath taken away [Heb. ‘asaph] my reproach.”","verses":199,"father":"Israel","mother":"Rachel","v":[23]},{"id":"ephod_1205","name":"Ephod","also":"","summary":"","verses":1,"father":"","mother":"","v":[23]},{"id":"hanniel_1401","name":"Hanniel","also":"","summary":"A chief of the tribe of Manasseh (Num. 34:23).","verses":1,"father":"Ephod","mother":"","v":[23]},{"id":"ephraim_1206","name":"Ephraim","also":"","summary":"Double fruitfulness (“for God had made him fruitful in the land of his affliction”). The second son of Joseph, born in Egypt (Gen. 41:52; 46:20).","verses":160,"father":"Joseph","mother":"Asenath","v":[24]},{"id":"kemuel_1774","name":"Kemuel","also":"","summary":"Son of Shiphtan, appointed on behalf of the tribe of Ephraim to partition the land of Canaan (Num. 34:24).","verses":1,"father":"Shiphtan","mother":"","v":[24]},{"id":"shiphtan_2711","name":"Shiphtan","also":"","summary":"Judicial, an Ephraimite prince at the time of the division of Canaan (Num. 34:24).","verses":1,"father":"","mother":"","v":[24]},{"id":"zebulun_3002","name":"Zebulun","also":"Zabulon","summary":"Dwelling, the sixth and youngest son of Jacob and Leah (Gen. 30:20). Little is known of his personal history.","verses":46,"father":"Israel","mother":"Leah","v":[25]},{"id":"elizaphan_1165","name":"Elizaphan","also":"","summary":"A prince of Zebulun.","verses":1,"father":"Parnach","mother":"","v":[25]},{"id":"parnach_2273","name":"Parnach","also":"","summary":"","verses":1,"father":"","mother":"","v":[25]},{"id":"issachar_645","name":"Issachar","also":"","summary":"Hired (Gen. 30:18). “God hath given me,” said Leah, “my hire (Heb. sekhari)...and she called his name Issachar.” He was Jacob’s ninth son, and was born in Padan-aram (comp. 28:2).","verses":38,"father":"Israel","mother":"Leah","v":[26]},{"id":"azzan_571","name":"Azzan","also":"","summary":"","verses":1,"father":"","mother":"","v":[26]},{"id":"paltiel_2270","name":"Paltiel","also":"","summary":"Deliverance of God, the prince of Issachar who assisted “to divide the land by inheritance” (Num. 34:26).","verses":1,"father":"Azzan","mother":"","v":[26]},{"id":"asher_337","name":"Asher","also":"Aser","summary":"Happy, Jacob’s eigth son; his mother was Zilpah, Leah’s handmaid (Gen. 30:13). Of the tribe founded by him nothing is recorded beyond its holding a place in the list of the tribes (35:26; 46:17; Ex. 1:4, etc.) It increased in numbers twenty-nine percent, during the thirty-eight years’ wanderings.","verses":43,"father":"Israel","mother":"Zilpah","v":[27]},{"id":"ahihud_133","name":"Ahihud","also":"","summary":"Name different in Hebrew, meaning brother of Judah.","verses":1,"father":"Shelomi","mother":"","v":[27]},{"id":"shelomi_2604","name":"Shelomi","also":"","summary":"","verses":1,"father":"","mother":"","v":[27]},{"id":"naphtali_2149","name":"Naphtali","also":"Nephthalim","summary":"My wrestling, the fifth son of Jacob. His mother was Bilhah, Rachel’s handmaid (Gen. 30:8). When Jacob went down into Egypt, Naphtali had four sons (Gen. 46:24).","verses":49,"father":"Israel","mother":"Bilhah","v":[28]},{"id":"ammihud_225","name":"Ammihud","also":"","summary":"Num. 34:28.","verses":1,"father":"","mother":"","v":[28]},{"id":"pedahel_2290","name":"Pedahel","also":"","summary":"Redeemed of God, the son of Ammihud, a prince of Naphtali (Num. 34:28).","verses":1,"father":"Ammihud","mother":"","v":[28]}],"places":[{"id":"canaan_272","name":"Canaan","kind":"Region (Country)","lat":31.69353,"lon":34.84388,"summary":"The country which derived its name from the preceding. The name as first used by the Phoenicians denoted only the maritime plain on which Sidon was built.","verses":76,"v":[2,29]},{"id":"edom_357","name":"Edom","kind":"Region","lat":31.25,"lon":34.75,"summary":"Idumea (Isa. 34:5, 6; Ezek. 35:15). “The field of Edom” (Gen. 32:3), “the land of Edom” (Gen. 36:16), was mountainous (Obad. 1:8, 9, 19, 21).","verses":79,"v":[3]},{"id":"salt_sea_1021","name":"salt sea","kind":"Water","lat":31.57785,"lon":35.52394,"summary":"The name given by Greek writers of the second century to that inland sea called in Scripture the “salt sea” (Gen. 14:3; Num. 34:12), the “sea of the plain” (Deut. 3:17), the “east sea” (Ezek. 47:18; Joel 2:20), and simply “the sea” (Ezek. 47:8).","verses":9,"v":[3,12]},{"id":"zin_1261","name":"Zin","kind":"Region","lat":30.68771,"lon":34.4948,"summary":"A low palm-tree, the south-eastern corner of the desert et-Tih, the wilderness of Paran, between the Gulf of Akabah and the head of the Wady Guraiyeh (Num. 13:21).","verses":7,"v":[3]},{"id":"akrabbim_44","name":"Akrabbim","kind":"Region","lat":30.68829,"lon":35.26318,"summary":"Scorpions, probably the general name given to the ridge containing the pass between the south of the Dead Sea and Zin, es-Sufah, by which there is an ascent to the level of the land of Palestine.","verses":3,"v":[4]},{"id":"azmon_130","name":"Azmon","kind":"","lat":30.95851,"lon":34.3805,"summary":"","verses":3,"v":[4,5]},{"id":"hazar-addar_536","name":"Hazar-addar","kind":"City","lat":30.9522,"lon":34.7187,"summary":"Village of Addar, a place in the southern boundary of Palestine (Num. 34:4), in the desert to the west of Kadesh-barnea.","verses":1,"v":[4]},{"id":"kadesh-barnea_663","name":"Kadesh-barnea","kind":"Oasis","lat":30.64805,"lon":34.42261,"summary":"Holy, or Kadesh-Barnea, sacred desert of wandering, a place on the south-eastern border of Palestine, about 165 miles from Horeb. It lay in the “wilderness” or “desert of Zin” (Gen. 14:7; Num. 13:3-26; 14:29-33; 20:1; 27:14), on the border of Edom (20:16).","verses":10,"v":[4]},{"id":"zin_1262","name":"Zin","kind":"","lat":30.68771,"lon":34.4948,"summary":"A low palm-tree, the south-eastern corner of the desert et-Tih, the wilderness of Paran, between the Gulf of Akabah and the head of the Wady Guraiyeh (Num. 13:21).","verses":2,"v":[4]},{"id":"egypt_259","name":"Egypt","kind":"Water (River)","lat":31.03205,"lon":33.85496,"summary":"The land of the Nile and the pyramids, the oldest kingdom of which we have any record, holds a place of great significance in Scripture.","verses":8,"v":[5]},{"id":"great_sea_493","name":"great sea","kind":"Water","lat":36.5802,"lon":17.11536,"summary":"(Joel 2:20; Ezek. 47:18), the Dead Sea, which lay on the east side of the Holy Land.","verses":12,"v":[6,7]},{"id":"mount_hor_843","name":"mount Hor","kind":"Mountain","lat":35.71007,"lon":36.18808,"summary":"One of the marks of the northern boundary of Palestine (Num. 34:7, 8). Nowhere else mentioned.","verses":2,"v":[7,8]},{"id":"lebo-hamath_723","name":"Lebo-hamath","kind":"","lat":34.19744,"lon":36.34204,"summary":"","verses":10,"v":[8]},{"id":"zedad_1246","name":"Zedad","kind":"City","lat":34.31257,"lon":36.92548,"summary":"Side; sloping place, a town in the north of Palestine, near Hamath (Num. 34:8; Ezek. 47:15).","verses":2,"v":[8]},{"id":"hazar-enan_537","name":"Hazar-enan","kind":"City","lat":34.2295,"lon":37.24008,"summary":"Village of fountains, a place on the north-east frontier of Palestine (Num. 34:9, 10). Some have identified it with Ayan ed-Dara in the heart of the central chain of Anti-Libanus.","verses":4,"v":[9,10]},{"id":"ziphron_1268","name":"Ziphron","kind":"","lat":34.2295,"lon":37.24008,"summary":"Sweet odour, a city on the northern border of Palestine (Num. 34:9), south-east of Hamath.","verses":1,"v":[9]},{"id":"shepham_1073","name":"Shepham","kind":"","lat":34.35307,"lon":36.38571,"summary":"A treeless place, Num. 34:10, 11: “The coast shall go down from Shepham to Riblah.”","verses":2,"v":[10,11]},{"id":"ain_41","name":"Ain","kind":"","lat":34.35307,"lon":36.38571,"summary":"","verses":1,"v":[11]},{"id":"riblah_1002","name":"Riblah","kind":"City","lat":34.35307,"lon":36.38571,"summary":"Fruitful, an ancient town on the northern frontier of Palestine, 35 miles north-east of Baalbec, and 10 or 12 south of Lake Homs, on the eastern bank of the Orontes, in a wide and fertile plain.","verses":1,"v":[11]},{"id":"sea_of_chinnereth_1029","name":"sea of Chinnereth","kind":"Water","lat":32.80678,"lon":35.58936,"summary":"","verses":2,"v":[11]},{"id":"jordan_653","name":"Jordan","kind":"Water (River)","lat":33.18645,"lon":35.61916,"summary":"But besides these two historical fountains there is a third, called the Hasbany, which rises in the bottom of a valley at the western base of Hermon, 12 miles north of Tell-el-Kady.","verses":177,"v":[12,15]},{"id":"gad_1286","name":"Gad","kind":"Region","lat":32.04697,"lon":35.7458,"summary":"Added from Digital Manna places-1262 (LPF sync 2026-10-13)","verses":21,"v":[14]},{"id":"jericho_634","name":"Jericho","kind":"City","lat":31.87005,"lon":35.44388,"summary":"Place of fragrance, a fenced city in the midst of a vast grove of palm trees, in the plain of Jordan, over against the place where that river was crossed by the Israelites (Josh. 3:16).","verses":58,"v":[15]}],"events":[],"traditions":[],"sources":["JFB","MHCC","Wesley"],"tags":{"bsb":[[3068,3068,3068,1696,413,4872],[6680,1121,1121,559,559,413,413,3588,859,935,776,776,3667,3667,776,5307,5307,5307,0,0,5159,5159,5159,1367,1367,1367],[0,5045,6285,1961,1961,4057,4057,4057,6790,6790,5921,3027,3027,123,123,6924,6924,6924,5045,5045,1366,1961,1961,7097,7097,7097,4417,4417,4417,3220],[5437,5045,4610,4610,4610,4610,4610,5674,6790,6790,1961,1961,5045,6947,6947,3318,3318,3318,3318,3318,2692,2692,5674,5674,6111,6111],[1366,1366,5437,5437,6111,6111,5158,5158,5158,4714,4714,1961,1961,3220,3220,3220],[0,3220,1366,1961,1961,1366,1366,1419,1419,1419,3220,2088,1961,1961,0,1366,3220,3220,3220],[0,6828,1366,1961,1961,4480,1419,1419,3220,8376,2022,2022,2023],[2022,2022,2022,2023,2574,2574,1366,1961,6657,6657],[3318,2202,2202,1961,1961,2704,2704,2088,1961,1961,0,1366,6828,6828,6828],[6924,6924,6924,1366,183,183,183,0,2704,8221,8221],[1366,3381,3381,8221,8221,7247,7247,6924,6924,6924,6924,5871,5871,3381,3381,3381,3802,3802,6924,3220,3220,3220,3672,3672],[1366,1366,1366,3381,3381,3381,3383,3383,3383,1961,1961,4417,4417,4417,3220,2063,1961,1961,0,776,1367,1367,1367,1367,5439,5439,5439],[4872,4872,6680,1121,1121,2063,2063,776,1486,1486,5157,5157,5157,3068,3068,6680,6680,6680,5414,5414,5414,8672,8672,8672,2677,2677,2677,4294],[3588,4294,4294,1121,1121,1121,4294,1121,2677,2677,2677,2677,4519,4519,3947,3947,3947,5159