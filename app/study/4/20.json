,"H2022","HTd/Ncmsa","the mountain"]],"x":[[5010006,5010006,5],[2029029,2029030,3]],"xn":2},"29":{"w":[["וַיִּרְאוּ","vaiyir'u","H7200","Hc/Vqw3mp","and they saw"],["כָּל","kol-","H3605","HNcmsc","all"],["הָעֵדָה","ha'edah","H5712","HTd/Ncfsa","the congregation"],["כִּי","ki","H3588","HTc","that"],["גָוַע","gava'","H1478","HVqp3ms","he had died"],["אַהֲרֹן","'aharon","H175","HNpm","Aaron"],["וַיִּבְכּוּ","vaiyivku","H1058","Hc/Vqw3mp","and they wept for"],["אֶת","'et-","H853","HTo","<obj.>"],["אַהֲרֹן","'aharon","H175","HNpm","Aaron"],["שְׁלֹשִׁים","sheloshim","H7970","HAcmpa","thirty"],["יוֹם","yom","H3117","HNcmsa","day[s]"],["כֹּל","kol","H3605","HNcmsc","all"],["בֵּית","beit","H1004","HNcmsc","[the] house of"],["יִשְׂרָאֵל","yisra'el","H3478","HNpl","Israel"]],"x":[[5034008,5034008,5]],"xn":1}},"people":[{"id":"israel_682","name":"Israel","also":"","summary":"One who follows on another’s heels; supplanter, (Gen. 25:26; 27:36; Hos. 12:2-4), the second born of the twin sons of Isaac by Rebekah. He was born probably at Lahai-roi, when his father was fifty-nine and Abraham one hundred and fifty-nine years old.","verses":1009,"father":"Isaac","mother":"Rebekah","v":[1,12,13,19,22,24]},{"id":"miriam_2087","name":"Miriam","also":"","summary":"The sister of Moses and Aaron (Ex. 2:4-10; 1 Chr. 6:3). Her name is prominent in the history of the Exodus. She is called “the prophetess” (Ex. 15:20).","verses":12,"father":"Amram","mother":"Jochebed","v":[1]},{"id":"moses_2108","name":"Moses","also":"","summary":"Drawn (or Egypt. mesu, “son;” hence Rameses, royal son). On the invitation of Pharaoh (Gen. 45:17-25), Jacob and his sons went down into Egypt.","verses":774,"father":"Amram","mother":"Jochebed","v":[2,3,6,7,9,10,11,12,14,23,27,28]},{"id":"aaron_1","name":"Aaron","also":"","summary":"The eldest son of Amram and Jochebed, a daughter of Levi (Ex. 6:20). Some explain the name as meaning mountaineer, others mountain of strength, illuminator.","verses":331,"father":"Amram","mother":"Jochebed","v":[2,6,8,10,12,23,24,25,26,28,29]},{"id":"esau_1216","name":"Esau","also":"Edom, Edomite","summary":"Hairy, Rebekah’s first-born twin son (Gen. 25:25). The name of Edom, “red”, was also given to him from his conduct in connection with the red lentil “pottage” for which he sold his birthright (30, 31).","verses":151,"father":"Isaac","mother":"Rebekah","v":[14,18,20,21,23]},{"id":"eleazar_1062","name":"Eleazar","also":"","summary":"The third son of Aaron (Ex. 6:23). His wife, a daughter of Putiel, bore him Phinehas (Ex. 6:25). After the death of Nadab and Abihu (Lev. 10:12; Num. 3:4) he was appointed to the charge of the sanctuary (Num. 3:32).","verses":61,"father":"Aaron","mother":"Elisheba","v":[25,26,28]}],"places":[{"id":"kadesh_661","name":"Kadesh","kind":"Oasis","lat":30.64805,"lon":34.42261,"summary":"Holy, or Kadesh-Barnea, sacred desert of wandering, a place on the south-eastern border of Palestine, about 165 miles from Horeb. It lay in the “wilderness” or “desert of Zin” (Gen. 14:7; Num. 13:3-26; 14:29-33; 20:1; 27:14), on the border of Edom (20:16).","verses":15,"v":[1,14,16,22]},{"id":"zin_1261","name":"Zin","kind":"Region","lat":30.68771,"lon":34.4948,"summary":"A low palm-tree, the south-eastern corner of the desert et-Tih, the wilderness of Paran, between the Gulf of Akabah and the head of the Wady Guraiyeh (Num. 13:21).","verses":7,"v":[1]},{"id":"egypt_362","name":"Egypt","kind":"Region (Country)","lat":26.4902,"lon":29.8808,"summary":"The land of the Nile and the pyramids, the oldest kingdom of which we have any record, holds a place of great significance in Scripture.","verses":564,"v":[5,15,16]},{"id":"meribah_782","name":"Meribah","kind":"Landmark (Spring)","lat":30.68771,"lon":34.4948,"summary":"Another fountain having a similar origin in the desert of Zin, near to Kadesh (Num. 27:14). The two places are mentioned together in Deut. 33:8.","verses":4,"v":[13,24]},{"id":"edom_357","name":"Edom","kind":"Region","lat":31.25,"lon":34.75,"summary":"Idumea (Isa. 34:5, 6; Ezek. 35:15). “The field of Edom” (Gen. 32:3), “the land of Edom” (Gen. 36:16), was mountainous (Obad. 1:8, 9, 19, 21).","verses":79,"v":[14,18,20,21,23]},{"id":"highway_690","name":"Highway","kind":"","lat":31.18133,"lon":35.70215,"summary":"","verses":2,"v":[17]},{"id":"mount_hor_842","name":"mount Hor","kind":"Mountain","lat":30.3274,"lon":35.4464,"summary":"One of the mountains of the chain of Seir or Edom, on the confines of Idumea (Num. 20:22-29; 33:37). It was one of the stations of the Israelites in the wilderness (33:37), which they reached in the circuitous route they were obliged to take because the Edomites refused them a passage through their territory.","verses":10,"v":[22,23,25,27]}],"events":[],"traditions":[],"sources":["JFB","MHCC","Wesley"],"tags":{"bsb":[[7223,7223,7223,2320,3605,3605,5712,3478,3478,935,4057,4057,6790,6790,5971,3427,6946,6946,8033,4813,4191,6912,6912,6912],[1961,1961,1961,3808,4325,5712,5712,5712,6950,6950,6950,5921,4872,175,175],[5971,5971,7378,5973,4872,559,559,3863,3863,1478,1478,1478,251,251,251,6440,3068,3068],[4100,935,935,935,3068,3068,6951,413,2088,4057,587,587,1165,1165,1165,4191,4191,8033],[4100,5927,5927,5927,5927,5927,4714,4714,4714,935,935,853,413,2088,7451,4725,3808,3808,3808,4725,4725,2233,2233,8384,1612,7416,7416,369,369,369,4325,8354,8354],[4872,4872,175,175,935,6440,6440,6440,6951,6951,6951,413,6607,6607,168,168,168,4150,4150,5307,5307,5307,3519,3519,3519,3068,3068,3068,7200,413,413],[3068,3068,3068,1696,413,4872],[3947,4294,4294,6950,6950,5712,5712,859,251,251,251,175,1696,1696,1696,413,5553,5553,5869,5869,5869,5414,5414,5414,5414,5414,4325,4325,3318,3318,3318,3318,4325,4480,5553,5553,8248,8248,8248,5712,5712,5712,1165,1165,1165],[4872,4872,3947,4294,4294,3068,3068,3068,6440,834,834,6680,6680,6680,6680],[4872,4872,175,175,6950,6951,6951,413,6440,5553,5553,5553,559,559,559,0,0,8085,4994,4784,4784,4325,4325,4325,4325,4325,3318,4480,2088,5553],[4872,4872,7311,3027,3027,5221,