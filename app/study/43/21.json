[{"id":"jesus_905","name":"Jesus","also":"Immanuel, Emmanuel, Messiah, Shiloh, Christ, Jesus Christ, Messias","summary":"Anointed, the Greek translation of the Hebrew word rendered “Messiah”, the official title of our Lord, occurring five hundred and fourteen times in the New Testament.","verses":1831,"father":"Joseph","mother":"Mary","v":[1,4,5,7,10,12,13,14,15,16,17,20,21,22,23,25]},{"id":"peter_2745","name":"Simon","also":"Cephas, Simeon","summary":"Originally called Simon (=Simeon, i.e., “hearing”), a very common Jewish name in the New Testament. He was the son of Jona (Matt. 16:17). His mother is nowhere named in Scripture.","verses":175,"father":"Jonas","mother":"","v":[2,3,7,11,15,16,17,20,21]},{"id":"thomas_2851","name":"Thomas","also":"Didymus","summary":"Twin, one of the twelve (Matt. 10:3; Mark 3:18, etc.). He was also called Didymus (John 11:16; 20:24), which is the Greek equivalent of the Hebrew name.","verses":12,"father":"","mother":"","v":[2]},{"id":"zebedee_2998","name":"Zebedee","also":"","summary":"A Galilean fisherman, the husband of Salome, and the father of James and John, two of our Lord’s disciples (Matt. 4:21; 27:56; Mark 15:40). He seems to have been a man of some position in Capernaum, for he had two boats (Luke 5:4) and “hired servants” (Mark 1:20) of his own.","verses":11,"father":"","mother":"","v":[2]},{"id":"nathanael_2158","name":"Nathanael","also":"","summary":"Given or gift of God, one of our Lord’s disciples, “of Cana in Galilee” (John 21:2). He was “an Israelite indeed, in whom was no guile” (1:47, 48).","verses":6,"father":"","mother":"","v":[2]},{"id":"jonas_1687","name":"Jonas","also":"","summary":"The father of the apostles Peter (John 21:15-17) and Andrew; but the reading should be (also in 1:42), as in the Revised Version, “John,” instead of Jonas.","verses":4,"father":"","mother":"","v":[15,16,17]}],"places":[{"id":"sea_of_tiberias_1034","name":"sea of Tiberias","kind":"Water","lat":32.80678,"lon":35.58936,"summary":"water","verses":2,"v":[1]},{"id":"cana_271","name":"Cana","kind":"City","lat":32.82389,"lon":35.30276,"summary":"Reedy, a town of Galilee, near Capernaum. Here our Lord wrought his first miracle, the turning of water into wine (John 2:1-11; 4:46). It is also mentioned as the birth-place of Nathanael (21:2).","verses":4,"v":[2]},{"id":"galilee_433","name":"Galilee","kind":"Region","lat":32.70675,"lon":35.30153,"summary":"Circuit. Solomon rewarded Hiram for certain services rendered him by the gift of an upland plain among the mountains of Naphtali. Hiram was dissatisfied with the gift, and called it “the land of Cabul”.","verses":63,"v":[2]}],"events":[],"traditions":[["peter-and-church-authority",15,19]],"sources":["Barnes","JFB","MHCC","Wesley"],"tags":{"bsb":[[3326,1909,3588,2281,5085,5085,2424,3825,5319,1438,3588,3588,3101,5319,5319,5319,5319,3779,3779,3779],[4613,4074,2381,3004,1324,3482,575,2580,1056,1056,3588,3588,2199,2199,2532,1417,243,3101,1510,3674],[4613,4074,3004,846,5217,5217,5217,232,1473,2064,2064,4862,4771,3004,3004,1831,1831,1831,1831,2532,1684,1519,3588,4143,2532,4084,3762,1565,3571],[4405,4405,4405,4405,2424,2476,1519,3588,123,3305,3588,3101,3756,3756,1492,3754,1510,1510,2424],[3767,2424,3004,3004,846,846,3813,2192,2192,2192,5100,4371,3756,611,611],[2036,2036,846,906,3588,1350,1519,3588,1188,3313,3588,3588,4143,2532,2147,2147,2147,2147,3767,906,906,906,906,2532,2480,2480,2480,1670,1670,1670,1670,575,575,3588,4128,4128,3588,2486],[3767,1565,3101,3739,2424,25,3004,4074,4074,1510,1510,3588,2962,3767,3767,3767,4613,4074,191,3754,1510,1510,3588,2962,1241,1241,1241,3588,1903,1903,1063,1510,1510,1510,1510,2532,906,1519,3588,2281],[3588,243,3101,2064,2064,3588,3588,4142,4951,4951,4951,3588,1350,3588,3588,2486,1063,1510,1510,3756,3112,575,1093,235,5613,1250,1250,1250],[5613,576,576,991,991,439,439,439,2749,2532,3795,1945,1945,2532,740,740],[2424,3004,846,5342,575,575,3588,3795,4084,4084,4084,4084],[3767,4613,4074,305,305,2532,1670,3588,1350,1093,3324,3324,3324,