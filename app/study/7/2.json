ama","mother":"","v":[8]},{"id":"ephraim_1206","name":"Ephraim","also":"","summary":"Double fruitfulness (“for God had made him fruitful in the land of his affliction”). The second son of Joseph, born in Egypt (Gen. 41:52; 46:20).","verses":160,"father":"Joseph","mother":"Asenath","v":[9]},{"id":"baal_573","name":"Baal","also":"Baal-peor","summary":"The name appropriated to the principal male god of the Phoenicians. It is found in several places in the plural BAALIM (Judg. 2:11; 10:10; 1 Kings 18:18; Jer. 2:23; Hos. 2:17).","verses":52,"father":"","mother":"","v":[13]}],"places":[{"id":"bochim_252","name":"Bochim","kind":"","lat":31.93054,"lon":35.22103,"summary":"Weepers, a place where the angel of the Lord reproved the Israelites for entering into a league with the people of the land. This caused them bitterly to weep, and hence the name of the place (Judg. 2:1, 5).","verses":2,"v":[1,5]},{"id":"egypt_362","name":"Egypt","kind":"Region (Country)","lat":26.4902,"lon":29.8808,"summary":"The land of the Nile and the pyramids, the oldest kingdom of which we have any record, holds a place of great significance in Scripture.","verses":564,"v":[1,12]},{"id":"gilgal_476","name":"Gilgal","kind":"City","lat":32.1547,"lon":34.95372,"summary":"From the solemn transaction of the reading of the law in the valley of Shechem between Ebal and Gerizim the Israelites moved forward to Gilgal, and there made a permanent camp (Josh. 9:6; 10:6).","verses":35,"v":[1]},{"id":"gaash_429","name":"Gaash","kind":"","lat":32.12147,"lon":35.15039,"summary":"A shaking, a hill, on the north side of which Joshua was buried (Josh. 24:30; Judg. 2:9), in the territory of Ephraim.","verses":4,"v":[9]},{"id":"timnath-heres_1166","name":"Timnath-heres","kind":"","lat":32.12147,"lon":35.15039,"summary":"Portion of the sun, where Joshua was buried (Judg. 2:9). It was “in the mount of Ephraim, in the north side of the hill Gaash,” 10 miles south-west of Shechem.","verses":1,"v":[9]}],"events":[{"id":"death_of_joshua_133","title":"Death of Joshua","year":-1424,"summary":"Passage: Joshua 24:29 – Judges 2:8. People: Joshua. Place: Timnath-serah.","v":[8]},{"id":"lifetime_of_joshua_124","title":"Lifetime of Joshua","year":-1521,"summary":"Passage: Judges 2:8. People: Joshua. Lasted about 110 years.","v":[8]},{"id":"deliverance_by_othniel_135","title":"Deliverance by Othniel","year":-1410,"summary":"Passage: Judges 2:16–3:11. People: Othniel. Place: Canaan. Lasted about 32 years.","v":[16,17,18,19,20,21,22,23]}],"traditions":[],"sources":["JFB","MHCC"],"tags":{"bsb":[[4397,4397,4397,3068,3068,3068,5927,5927,4480,1537,413,1066,559,559,5927,5927,5927,5927,4714,4714,4714,935,935,413,413,776,776,834,7650,7650,7650,1,1,1,559,559,559,3808,3808,3808,6565,1285,1285,854,854],[859,859,3808,3808,3772,3772,1285,1285,3427,3427,3427,2063,2063,776,5422,5422,5422,5422,5422,4196,4196,3808,3808,3808,3808,8085,6963,6963,4100,2063,2063,6213,6213,6213],[1571,1571,559,559,559,3808,3808,3808,3808,1644,1644,1644,1644,6440,6440,1961,1961,1961,1961,0,0,6654,430,430,430,1961,1961,4170,4170,0,0],[4397,4397,4397,3068,3068,3068,1696,1696,428,1697,413,3605,1121,1121,5971,5971,5375,5375,6963,6963,1058,1058],[7121,7121,7121,1931,4725,1066,2076,2076,2076,8033,3068,3068,3068],[3091,3091,7971,7971,5971,5971,1121,1121,1980,1980,3423,3423,3423,3423,776,776,376,5159,5159,5159,5159],[5971,5971,5971,5647,3068,3068,3605,3117,3117,3091,3091,3605,2205,2205,2205,834,748,3091,834,7200,7200,3605,1419,1419,4639,834,3068,3068,6213,6213,3478,3478],[3091,3091,1121,5126,5126,5650,5650,3068,3068,3068,4191,1121,1121,1121,3967,3967],[6912,6912,853,1366,1366,1366,5159,5159,5159,8556,8556,2022,2022,2022,2022,669,669,6828,2022,2022,1608],[310,310,3605,1755,1571,1571,622,622,413,1,1,312,1755,6965,6965,834,3808,3808,3045,3068,3068,1571,4639,4639,834,6213,6213,6213,3478,3478],[1121,1121,1121,6213,7451,5869,5869,5869,3068,3068,3068,5647,5647,1168,1168],[5800,5800,5800,3068,3068,430,430,1,1,1,3318,3318,3318,3318,776,776,776,776,4714,