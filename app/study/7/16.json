,"and he"],["שָׁפַט","shafat","H8199","HVqp3ms","he judged"],["אֶת","'et-","H853","HTo","<obj.>"],["יִשְׂרָאֵל","yisra'el","H3478","HNpl","Israel"],["עֶשְׂרִים","'esrim","H6242","HNcmpa","twenty"],["שָׁנָה","shanah","H8141","HNcfsa","year[s]"]],"x":[[7015020,7015020,4],[7013002,7013002,3],[7013025,7013025,3],[43019039,43019042,3]],"xn":4}},"people":[{"id":"samson_2468","name":"Samson","also":"","summary":"Of the sun, the son of Manoah, born at Zorah. The narrative of his life is given in Judg. 13-16. He was a “Nazarite unto God” from his birth, the first Nazarite mentioned in Scripture (Judg. 13:3-5; comp. Num. 6:1-21).","verses":38,"father":"Manoah","mother":"","v":[1,2,3,6,7,9,10,12,13,14,20,23,25,26,27,28,29,30]},{"id":"delilah_1005","name":"Delilah","also":"","summary":"Languishing, a Philistine woman who dwelt in the valley of Sorek (Judg. 16:4-20). She was bribed by the “lords of the Philistines” to obtain from Samson the secret of his strength and the means of overcoming it (Judg. 16:4-18).","verses":6,"father":"","mother":"","v":[4,6,10,12,13,18]},{"id":"dagon_969","name":"Dagon","also":"","summary":"Little fish; diminutive from dag = a fish, the fish-god; the national god of the Philistines (Judg. 16:23). This idol had the body of a fish with the head and hands of a man.","verses":7,"father":"","mother":"","v":[23]},{"id":"manoah_1933","name":"Manoah","also":"","summary":"Rest, a Danite, the father of Samson (Judg. 13:1-22, and 14:2-4).","verses":14,"father":"","mother":"","v":[31]}],"places":[{"id":"gaza_446","name":"Gaza","kind":"City","lat":31.50396,"lon":34.46203,"summary":"Called also Azzah, which is its Hebrew name (Deut. 2:23; 1 Kings 4:24; Jer. 25:20), strong, a city on the Mediterranean shore, remarkable for its early importance as the chief centre of a great commercial traffic with Egypt.","verses":19,"v":[1,21]},{"id":"hebron_551","name":"Hebron","kind":"City","lat":31.52435,"lon":35.10854,"summary":"A city in the south end of the valley of Eshcol, about midway between Jerusalem and Beersheba, from which it is distant about 20 miles in a straight line.","verses":56,"v":[3]},{"id":"valley_of_sorek_1220","name":"valley of Sorek","kind":"Valley","lat":31.82573,"lon":34.98901,"summary":"Choice vine, the name of a valley, i.e., a torrent-bed, now the Wady Surar, “valley of the fertile spot,” which drains the western Judean hills, and flowing by Makkedah and Jabneel, falls into the sea some eight miles south of Joppa.","verses":1,"v":[4]},{"id":"eshtaol_411","name":"Eshtaol","kind":"City","lat":31.78243,"lon":35.00901,"summary":"Narrow pass or recess, a town (Josh. 15:33) in the low country, the She-phelah of Judah. It was allotted to the tribe of Dan (Josh. 19:41), and was one of their strongholds.","verses":7,"v":[31]},{"id":"zorah_1275","name":"Zorah","kind":"City","lat":31.76214,"lon":34.96932,"summary":"Place of wasps, a town in the low country of Judah, afterwards given to Dan (Josh. 19:41; Judg. 18:2), probably the same as Zoreah (Josh. 15:33).","verses":9,"v":[31]}],"events":[{"id":"sampson_destroys_temple_of_dagon_154","title":"Sampson destroys Temple of Dagon","year":-1101,"summary":"Passage: Judges 16:23–31. People: Samson.","v":[23,24,25,26,27,28,29,30,31]},{"id":"judgeship_of_samson_153","title":"Judgeship of Samson","year":-1121,"summary":"Passage: Judges 15:20–16:31. People: Samson. Place: Canaan. Lasted about 20 years.","v":[31]}],"traditions":[],"sources":["JFB","MHCC"],"tags":{"bsb":[[8123,8123,8123,1980,5804,5804,8033,7200,7200,2181,2181,935,935,935,935,935,935,935,413,413],[5841,5841,5841,559,559,8123,935,2008,5437,5437,5437,5437,693,693,693,693,0,0,3605,3915,5892,5892,5892,8179,2790,2790,2790,3605,3915,3915,559,5704,5704,5704,5704,216,2026,2026,2026,2026,2026],[8123,8123,7901,7901,5704,5704,2677,6965,6965,6965,6965,270,270,1817,1817,1817,5892,5892,5892,8179,8147,8147,4201,5265,5265,5265,5265,1280,5973,5973,7760,7760,7760,7760,5921,3802,3802,5927,5927,5927,413,7218,7218,2022,2022,2022,5921,227