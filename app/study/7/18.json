,"mother":"","v":[30]}],"places":[{"id":"dan_1283","name":"Dan","kind":"Region","lat":31.77399,"lon":34.98529,"summary":"Added from Digital Manna places-1259 (LPF sync 2026-10-13)","verses":9,"v":[1]},{"id":"eshtaol_411","name":"Eshtaol","kind":"City","lat":31.78243,"lon":35.00901,"summary":"Narrow pass or recess, a town (Josh. 15:33) in the low country, the She-phelah of Judah. It was allotted to the tribe of Dan (Josh. 19:41), and was one of their strongholds.","verses":7,"v":[2,8,11]},{"id":"zorah_1275","name":"Zorah","kind":"City","lat":31.76214,"lon":34.96932,"summary":"Place of wasps, a town in the low country of Judah, afterwards given to Dan (Josh. 19:41; Judg. 18:2), probably the same as Zoreah (Josh. 15:33).","verses":9,"v":[2,8,11]},{"id":"laish_713","name":"Laish","kind":"City","lat":33.24866,"lon":35.65248,"summary":"A city of the Sidonians, in the extreme north of Palestine (Judg. 18:7, 14); called also Leshem (Josh. 19:47) and Dan (Judg. 18:7, 29; Jer. 8:16).","verses":4,"v":[7,14,27,29]},{"id":"kiriath-jearim_701","name":"Kiriath-jearim","kind":"City","lat":31.7711,"lon":34.99381,"summary":"City, a city belonging to Benjamin (Josh. 18:28), the modern Kuriet el-‘Enab, i.e., “city of grapes”, about 7 1/2 miles west-north-west of Jerusalem.","verses":15,"v":[12]},{"id":"mahaneh-dan_757","name":"Mahaneh-dan","kind":"","lat":31.75831,"lon":34.99425,"summary":"Judg. 18:12 = “camp of Dan” 13:25 (R.V., “Mahaneh-dan”), a place behind (i.e., west of) Kirjath-jearim, where the six hundred Danites from Zorah and Eshtaol encamped on their way to capture the city of Laish, which they rebuilt and called “Dan, after the name of their father” (18:11-31).","verses":2,"v":[12]},{"id":"beth-rehob_230","name":"Beth-rehob","kind":"","lat":33.21935,"lon":35.54412,"summary":"","verses":2,"v":[28]},{"id":"sidon_1093","name":"Sidon","kind":"City","lat":33.56024,"lon":35.37121,"summary":"A fishery, a town on the Mediterranean coast, about 25 miles north of Tyre. It received its name from the “first-born” of Canaan, the grandson of Noah (Gen. 10:15, 19).","verses":30,"v":[28]},{"id":"dan_323","name":"Dan","kind":"Region","lat":33.24856,"lon":35.65252,"summary":"The fifth son of Jacob. His mother was Bilhah, Rachel’s maid (Gen. 30:6, “God hath judged me”, Heb. dananni).","verses":20,"v":[29]},{"id":"shiloh_1081","name":"Shiloh","kind":"City","lat":32.05617,"lon":35.28988,"summary":"Generally understood as denoting the Messiah, “the peaceful one,” as the word signifies (Gen. 49:10). The Vulgate Version translates the word, “he who is to be sent,” in allusion to the Messiah; the Revised Version, margin, “till he come to Shiloh;” and the LXX., “until that which is his shall come to Shiloh.”","verses":30,"v":[31]}],"events":[],"traditions":[],"sources":["JFB","MHCC"],"tags":{"bsb":[[1992,1992,3117,369,369,369,4428,3478,3478,3117,7626,7626,1839,1839,1839,1245,1245,1245,5159,3427,3427,3588,5704,5704,1931,3117,3808,3808,3808,5307,5307,5159,5159,8432,7626,7626,3478,3478],[1121,1121,1121,7971,7971,2568,582,4940,4940,4940,582,1121,2428,6881,6881,847,847,7270,7270,7270,776,776,2713,2713,2713,1980,2713,2713,776,776,559,559,559,935,935,935,2022,2022,2022,669,669,5704,5704,5704,1004,1004,4318,4318,3885,3885,3885,3885,3885],[1992,1992,1992,5973,5973,4318,1004,1992,5234,6963,6963,5288,5288,5288,3881,5493,5493,5493,5493,559,559,0,4310,935,1988,1988,4100,859,859,6213,2088,2088,2088,4100,0,0,6311],[4318,6213,6213,2090,2088,2088,0,0,559,559,7936,7936,7936,7936,7936,1961,1961,0,3548],[559,559,559,0,0,4994,7592,430,430,3045,3045,587,587,6743,6743,6743,6743,1870],[3548,3548,3548,559,0,1980,7965,7965,3068,3068,5227,5227,5227,1870,1870],[2568,2568,2568,582,1980,935,935,3919,3919,7200,7200,7200,5971,5971,5971,3427,3427,983,4941,6722,6722,8252,982,982,369,369,369,3637,776,776,776,3423,3423,3423,6114,1992,1992,7350,7350,7350,6722,6722,6722,369,369,369,1697,5973,120],[935,935,935,935,413,6881,847,847,251,251,559,0,4100,859,859,859],[559,559,6965,6965,5927,5927,5927,59