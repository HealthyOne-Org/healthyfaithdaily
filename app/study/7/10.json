,["מִי","mi","H4310","HPi","who?"],["הָאִישׁ","ha'ish","H376","HTd/Ncmsa","[is] the man"],["אֲשֶׁר","'asher","H834","HTr","who"],["יָחֵל","yachel","H2490","HVhi3ms","he will begin"],["לְהִלָּחֵם","lehilachem","H3898","HR/VNcc","to fight"],["בִּבְנֵי","bivnei","H1121","HR/Ncmpc","against [the] people of"],["עַמּוֹן","amon","H5983","HNpm","Ammon"],["יִהְיֶה","yihyeh","H1961","HVqi3ms","he will become"],["לְרֹאשׁ","lerosh","H7218","HR/Ncmsa","<into> chief"],["לְכֹל","lekhol","H3605","HR/Ncmsc","of all"],["יֹשְׁבֵי","yoshevei","H3427","HVqrmpc","[the] inhabitants of"],["גִלְעָד","gil'ad","H1568","HNpl","Gilead"]],"x":[[7011011,7011011,4]],"xn":1}},"people":[{"id":"ephraim_1206","name":"Ephraim","also":"","summary":"Double fruitfulness (“for God had made him fruitful in the land of his affliction”). The second son of Joseph, born in Egypt (Gen. 41:52; 46:20).","verses":160,"father":"Joseph","mother":"Asenath","v":[1,9]},{"id":"issachar_645","name":"Issachar","also":"","summary":"Hired (Gen. 30:18). “God hath given me,” said Leah, “my hire (Heb. sekhari)...and she called his name Issachar.” He was Jacob’s ninth son, and was born in Padan-aram (comp. 28:2).","verses":38,"father":"Israel","mother":"Leah","v":[1]},{"id":"abimelech_41","name":"Abimelech","also":"","summary":"A son of Gideon (Judg. 9:1), who was proclaimed king after the death of his father (Judg. 8:33-9:6). One of his first acts was to murder his brothers, seventy in number, “on one stone,” at Ophrah.","verses":36,"father":"Gideon","mother":"","v":[1]},{"id":"dodo_1020","name":"Dodo","also":"","summary":"A descendant of Issachar (Judg. 10:1).","verses":1,"father":"","mother":"","v":[1]},{"id":"puah_2373","name":"Puah","also":"","summary":"A descendant of Issachar (Judg. 10:1).","verses":1,"father":"Dodo","mother":"","v":[1]},{"id":"tola_2879","name":"Tola","also":"","summary":"A judge of the tribe of Issachar who “judged” Israel twenty-three years (Judg. 10:1, 2), when he died, and was buried in Shamir.","verses":1,"father":"Puah","mother":"","v":[1]},{"id":"jair_709","name":"Jair","also":"","summary":"Gileadite.","verses":2,"father":"","mother":"","v":[3,5]},{"id":"israel_682","name":"Israel","also":"","summary":"One who follows on another’s heels; supplanter, (Gen. 25:26; 27:36; Hos. 12:2-4), the second born of the twin sons of Isaac by Rebekah. He was born probably at Lahai-roi, when his father was fifty-nine and Abraham one hundred and fifty-nine years old.","verses":1009,"father":"Isaac","mother":"Rebekah","v":[6,8,10,11,15,17]},{"id":"moab_2103","name":"Moab","also":"Moabitess, Moabitish, Moabites","summary":"Used to denote the people of Moab (Num. 22:3-14; Judg. 3:30; 2 Sam. 8:2; Jer. 48:11, 13).","verses":149,"father":"Lot","mother":"Daughter of Lot - Older","v":[6]},{"id":"judah_1751","name":"Judah","also":"","summary":"Praise, the fourth son of Jacob by Leah.","verses":245,"father":"Israel","mother":"Leah","v":[9]},{"id":"benjamin_463","name":"Benjamin","also":"Ben-oni","summary":"The younger son of Jacob by Rachel (Gen. 35:18). His birth took place at Ephrath, on the road between Bethel and Bethlehem, at a short distance from the latter place.","verses":157,"father":"Israel","mother":"Rachel","v":[9]}],"places":[{"id":"shamir_1061","name":"Shamir","kind":"","lat":32.36047,"lon":35.25005,"summary":"The residence of Tola, one of the judges, on Mount Ephraim (Judg. 10:1, 2).","verses":2,"v":[1,2]},{"id":"gilead_475","name":"Gilead","kind":"Region","lat":32.75,"lon":35.75,"summary":"Hill of testimony, (Gen. 31:21), a mountainous region east of Jordan. From its mountainous character it is called “the mount of Gilead” (Gen. 31:25).","verses":80,"v":[4,8,17,18]},{"id":"havvoth-jair_535","name":"Havvoth-jair","kind":"","lat":32.04252,"lon":35.72424,"summary":"","verses":4,"v":[4]},{"id":"kamon_665","name":"Kamon","kind":"City","lat":32.04252,"lon":35.72424,"summary":"Full of stalks, a place (Judg. 10:5) where Jair was buried. It has usually been supposed to have been a city of Gilead, on the east of Jordan.","verses":1,"v":[5]},{"id":"moab_815","name":"Moab","kind":"Region (Country)","lat":31.49916,"lon":35.78051,"summary":"The land of Moab (Jer. 48:24), called also the “country of Moab” (Ruth 1:2, 6; 2:6), on the east of Jordan and the Dead Sea, and south of the Arnon (Num. 21:13, 26).","verses":148,"v":[6]},{"id":"sidon_1093","name":"Sidon","kind":"City","lat":33.56024,"lon":35.37121,"summary":"A fishery, a town on the Mediterranean coast, about 25 miles north of Tyre. It received its name from the “first-born” of Canaan, the grandson of Noah (Gen. 10:15, 19).","verses":30,"v":[6]},{"id":"syria_1122","name":"Syria","kind":"Region (Country)","lat":37.5,"lon":37.5,"summary":"(Heb. Aram), the name in the Old Testament given to the whole country which lay to the north-east of Phoenicia, extending to beyond the Euphrates and the Tigris.","verses":64,"v":[6]},{"id":"jordan_653","name":"Jordan","kind":"Water (River)","lat":33.18645,"lon":35.61916,"summary":"But besides these two historical fountains there is a third, called the Hasbany, which rises in the bottom of a valley at the western base of Hermon, 12 miles north of Tell-el-Kady.","verses":177,"v":[8,9]},{"id":"mizpah_809","name":"Mizpah","kind":"","lat":32.56527,"lon":36.00556,"summary":"A place in Gilead, so named by Laban, who overtook Jacob at this spot (Gen. 31:49) on his return to Palestine from Padan-aram. Here Jacob and Laban set up their memorial cairn of stones.","verses":6,"v":[17]}],"events":[{"id":"judgeship_of_tola_143","title":"Judgeship of Tola","year":-1215,"summary":"Passage: Judges 10:1–2. People: Tola. Place: Canaan. Lasted about 23 years.","v":[1,2]},{"id":"judgeship_of_jair_67","title":"Judgeship of Jair","year":-1192,"summary":"Passage: Judges 10:3–5. People: Jair. Place: Canaan. Lasted about 22 years.","v":[3,4,5]},{"id":"oppression_by_ammon_and_philistia_144","title":"Oppression by Ammon and Philistia","year":-1170,"summary":"Passage: Judges 10:6–18. P