{"entries":[{"h":"Enable","m":"to make able, qualify","n":"Like French, to make able for any purpose.","pos":"v.t.","refs":["54:1:12"]},{"h":"Enchantment","m":"incantation","n":"From Latin, the chanting of a magical verse supposed to have potent influence.","pos":"sb.","refs":["2:7:11","3:19:26","21:10:11"]},{"h":"Endamage","m":"to damage, harm","n":"From French and Latin; now represented by the shorter 'damage'.","pos":"v.t.","refs":["15:4:13"]},{"h":"Endue","m":"to furnish with a dowry; hence with any gift or qualification","n":"From Latin 'dowry'.","refs":["1:30:20"]},{"h":"Engrafted","m":"grafted","n":"Another case where the longer form has been rejected and the shorter retained.","pos":"pp.","refs":[]},{"h":"Enlarge","m":"to set at liberty, set free","pos":"v.t.","refs":["10:22:37","19:4:1"]},{"h":"Ensue","m":"to follow after and overtake","n":"From French and Latin; obsolete in this sense now.","pos":"v.t.","refs":[]},{"h":"Enticing","m":"persuasive","n":"The margin gives 'persuasible'.","pos":"adj.","refs":["46:2:4","51:2:4"]},{"h":"Entreat","m":"to treat","n":"Where we should now use 'treat'.","pos":"v.t.","refs":["1:12:16","2:5:22","24:15:11","42:18:32","44:27:3"]},{"h":"Envy","m":"malice, ill-will, spite","pos":"sb.","refs":["44:7:9","45:1:29"]},{"h":"Envying","m":"envy","pos":"sb.","refs":["45:13:13","59:3:14"]}],"forms":{"enabled":[0],"enchantment":[1],"enchantments":[1],"endamage":[2],"endued":[3],"engrafted":[4],"enlarge":[5],"enlarged":[5],"enlargeth":[5],"enlarging":[5],"ensue":[6],"enticing":[7],"entreat":[8],"entreated":[8],"entreateth":[8],"envied":[9],"envies":[9],"enviest":[9],"envieth":[9],"envy":[9],"envying":[9,10],"envyings":[10]}}