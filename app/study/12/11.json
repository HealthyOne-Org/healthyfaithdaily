lso":"","summary":"Beloved, the eighth and youngest son of Jesse, a citizen of Bethlehem. His father seems to have been a man in humble life. His mother’s name is not recorded.","verses":896,"father":"Jesse","mother":"","v":[10]},{"id":"baal_573","name":"Baal","also":"Baal-peor","summary":"The name appropriated to the principal male god of the Phoenicians. It is found in several places in the plural BAALIM (Judg. 2:11; 10:10; 1 Kings 18:18; Jer. 2:23; Hos. 2:17).","verses":52,"father":"","mother":"","v":[18]},{"id":"mattan_1948","name":"Mattan","also":"","summary":"A priest of Baal, slain before his altar during the reformation under Jehoiada (2 Kings 11:18).","verses":2,"father":"","mother":"","v":[18]}],"places":[{"id":"sur_1117","name":"Sur","kind":"","lat":31.77744,"lon":35.23494,"summary":"","verses":1,"v":[6]}],"events":[{"id":"reign_of_athaliah_191","title":"Reign of Athaliah","year":-886,"summary":"Passage: 2 Kings 11:1–3. People: Athaliah. Place: Jerusalem. Lasted about 7 years.","v":[1,2,3]},{"id":"reign_of_joash_193","title":"Reign of Joash","year":-879,"summary":"Passage: 2 Kings 11:21–12:21. People: Joash. Place: Jerusalem. Lasted about 40 years.","v":[21]}],"traditions":[],"sources":["JFB","MHCC","Wesley"],"tags":{"bsb":[[6271,6271,517,517,274,274,7200,3588,1121,1121,4191,4191,6965,6965,6,6,3605,4467,4467,2233],[3089,3089,1323,4428,4428,3141,269,269,274,274,3947,3101,1121,274,274,1589,1589,1589,1589,8432,8432,1121,1121,4428,4428,4428,4191,4191,4191,4191,3243,3243,3243,3243,3243,3243,2315,2315,2315,5641,5641,853,6440,6271,3808,3808,3808,3808,4191],[1961,1961,1961,2244,854,854,854,1004,1004,1004,3068,3068,3068,8337,8337,8141,6271,6271,4427,776,776],[7637,7637,7637,7637,8141,3077,7971,7971,8269,8269,3967,3967,3746,3746,7323,7323,7323,935,935,935,935,1004,1004,1004,3068,3068,3068,1004,3772,3772,1285,1285,0,0,7650,7650,7650,7650,7650,7200,7200,853,4428,4428,1121],[6680,6680,6680,2088,834,834,6213,6213,6213,6213,7992,7992,0,0,935,935,935,935,7676,7676,7676,8