oseph_1710","name":"Joseph","also":"Zaphnath-paaneah","summary":"The elder of the two sons of Jacob by Rachel (Gen. 30:23, 24), who, on the occasion of his birth, said, “God hath taken away [Heb. ‘asaph] my reproach.”","verses":199,"father":"Israel","mother":"Rachel","v":[2,7]},{"id":"canaan_914","name":"Canaan","also":"Canaanites, Canaanite","summary":"The fourth son of Ham (Gen. 10:6). His descendants were under a curse in consequence of the transgression of his father (9:22-27). His eldest son, Zidon, was the father of the Sidonians and Phoenicians.","verses":84,"father":"Ham","mother":"","v":[18]},{"id":"shechem_2588","name":"Shechem","also":"Sychem","summary":"The son of Hamor the Hivite (Gen. 33:19; 34).","verses":15,"father":"Hamor","mother":"","v":[18,19]},{"id":"hamor_1365","name":"Hamor","also":"Emmor","summary":"He-ass, a Hivite from whom Jacob purchased the plot of ground in which Joseph was afterwards buried (Gen. 33:19). He is called “Emmor” in Acts 7:16.","verses":13,"father":"","mother":"","v":[19]}],"places":[{"id":"seir_1042","name":"Seir","kind":"Region","lat":30.73469,"lon":35.60625,"summary":"The name of a mountainous region occupied by the Edomites, extending along the eastern side of the Arabah from the south-eastern extremity of the Dead Sea to near the Akabah, or the eastern branch of the Red Sea.","verses":24,"v":[14,16]},{"id":"succoth_1113","name":"Succoth","kind":"City","lat":32.19571,"lon":35.62161,"summary":"A city on the east of Jordan, identified with Tell Dar’ala, a high mound, a mass of debris, in the plain north of Jabbok and about one mile from it (Josh. 13:27).","verses":10,"v":[17]},{"id":"canaan_272","name":"Canaan","kind":"Region (Country)","lat":31.69353,"lon":34.84388,"summary":"The country which derived its name from the preceding. The name as first used by the Phoenicians denoted only the maritime plain on which Sidon was built.","verses":76,"v":[18]},{"id":"paddan-aram_916","name":"Paddan-aram","kind":"","lat":36.86386,"lon":39.0322,"summary":"The plain of Aram, or the plain of the highlands, (Gen. 25:20; 28:2, 5-7; 31:18, etc.), commonly regarded as the district of Mesopotamia lying around Haran.","verses":10,"v":[18]},{"id":"shechem_1069","name":"Shechem","kind":"City","lat":32.22111,"lon":35.25444,"summary":"A city in Samaria (Gen. 33:18), called also Sichem (12:6), Sychem (Acts 7:16). It stood in the narrow sheltered valley between Ebal on the north and Gerizim on the south, these mountains at their base being only some 500 yards apart.","verses":40,"v":[18]},{"id":"el-elohe-israel_1279","name":"El-elohe-Israel","kind":"Landmark","lat":32.21361,"lon":35.28194,"summary":"Added from Digital Manna places-0390 (LPF sync 2026-10-13)","verses":1,"v":[20]}],"events":[],"traditions":[],"sources":["JFB","MHCC","Wesley"],"tags":{"bsb":[[3290,3290,5375,5375,7200,7200,6215,935,5973,5973,5973,702,3967,376,2673,2673,2673,3206,3206,3812,3812,7354,8147,8147,8147,8198],[7760,7760,8198,8198,853,853,3206,7223,7223,3812,3206,3206,3206,314,7354,7354,3130,3130,314,314,314],[1931,1931,1931,5674,5674,6440,7812,7812,776,776,776,7651,6471,5704,5066,5066,251,251],[6215,6215,7323,7323,7323,2263,2263,2263,5307,5307,5307,5307,6677,6677,5401,5401,5401,1058,1058,1058,1058],[5375,5375,5375,5375,7200,7200,802,802,3206,3206,559,559,4310,428,428,0,0,559,559,3206,3206,3206,3206,430,2603,2603,2603,5650,5650],[8198,8198,8198,2007,2007,3206,5066,7812,7812,7812],[3812,3206,3206,3206,1571,5066,7812,7812,7812,310,310,3130,7354,7354,5066,7812,7812,7812],[4310,0,0,0,2088,2088,2088,3605,4264,6298,6298,6298,559,559,4672,4672,2580,5869,5869,5869,113,113,559,559],[3426,3426,3426,7227,251,251,6215,559,1961,834,834,0,0],[3290,3290,559,408,4994,518,4672,4672,4672,2580,5869,5869,5869,3947,3947,4503,4503,3027,3027,3027,5921,3588,7200,7200,7200,6440,6440,7200,7200,7200,7200,7200,6440,6440,430,430,7521,7521,7521,7521,7521,7521],[4994,3947,1293,1293,834,935,935,0,0,3588,430,2603,2603,2603,0,0,3426,3426,3426,3605,3605,3605,6484,6484,6