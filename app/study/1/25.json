2013,23022013,5],[40026015,40026015,5],[46015032,46015032,5],[19106024,19106024,4],[38011013,38011013,4],[40022005,40022005,4],[42014018,42014020,4],[44013041,44013041,4]],"xn":11}},"people":[{"id":"abraham_58","name":"Abraham","also":"Abram","summary":"Father of a multitude, son of Terah, named (Gen. 11:27) before his older brothers Nahor and Haran, because he was the heir of the promises. Till the age of seventy, Abram sojourned among his kindred in his native country of Chaldea.","verses":277,"father":"Terah","mother":"","v":[1,5,6,7,8,10,11,12,19]},{"id":"keturah_1782","name":"Keturah","also":"","summary":"Incense, the wife of Abraham, whom he married probably after Sarah’s death (Gen. 25:1-6), by whom he had six sons, whom he sent away into the east country.","verses":4,"father":"","mother":"","v":[1,4]},{"id":"midian_2075","name":"Midian","also":"Midianites, Midianitish","summary":"Strife, the fourth son of Abraham by Keturah, the father of the Midianites (Gen. 25:2; 1 Chr. 1:32).","verses":38,"father":"Abraham","mother":"Keturah","v":[2,4]},{"id":"jokshan_1685","name":"Jokshan","also":"","summary":"Snarer, the second son of Abraham and Keturah (Gen. 25:2, 3; 1 Chr. 1:32).","verses":3,"father":"Abraham","mother":"Keturah","v":[2,3]},{"id":"ishbak_620","name":"Ishbak","also":"","summary":"Leaving, one of Abraham’s sons by Keturah (Gen. 25:2).","verses":2,"father":"Abraham","mother":"Keturah","v":[2]},{"id":"medan_1978","name":"Medan","also":"","summary":"A son of Jokshan, Abraham’s son by Keturah (1 Chr. 1:32). His descendants settled on the Syrian borders about the territory of Edom.","verses":2,"father":"Abraham","mother":"Keturah","v":[2]},{"id":"shuah_2727","name":"Shuah","also":"","summary":"One of Abraham’s sons by Keturah (Gen. 25:2; Chr. 1:32).","verses":2,"father":"Abraham","mother":"Keturah","v":[2]},{"id":"zimran_3086","name":"Zimran","also":"","summary":"Vine-dressers; celebrated, one of the sons of Abraham by Keturah (Gen. 25:2).","verses":2,"father":"Abraham","mother":"Keturah","v":[2]},{"id":"dedan_999","name":"Dedan","also":"","summary":"A son of Jokshan, Abraham’s son by Keturah (1 Chr. 1:32). His descendants settled on the Syrian borders about the territory of Edom.","verses":2,"father":"Jokshan","mother":"","v":[3]},{"id":"sheba_2569","name":"Sheba","also":"","summary":"Heb. id.","verses":2,"father":"Jokshan","mother":"","v":[3]},{"id":"asshurim_350","name":"Asshurim","also":"","summary":"","verses":1,"father":"Dedan","mother":"","v":[3]},{"id":"letushim_1818","name":"Letushim","also":"","summary":"","verses":1,"father":"Dedan","mother":"","v":[3]},{"id":"leummim_1819","name":"Leummim","also":"","summary":"Peoples; nations, the last mentioned of the three sons of Dedan, and head of an Arabian tribe (Gen. 25:3).","verses":1,"father":"Dedan","mother":"","v":[3]},{"id":"ephah_1197","name":"Ephah","also":"","summary":"Descendant of Keturah.","verses":3,"father":"Midian","mother":"","v":[4]},{"id":"abida_21","name":"Abida","also":"","summary":"Or Abi’dah, father of knowledge; knowing, one of the five sons of Midian, who was the son of Abraham by Keturah (1 Chr. 1:33), and apparently the chief of an Arab tribe.","verses":2,"father":"Midian","mother":"","v":[4]},{"id":"eldaah_1057","name":"Eldaah","also":"","summary":"","verses":2,"father":"Midian","mother":"","v":[4]},{"id":"epher_1201","name":"Epher","also":"","summary":"One of the sons of Midian, who was Abraham’s son by Keturah (Gen. 25:4).","verses":2,"father":"Midian","mother":"","v":[4]},{"id":"henoch_1402","name":"Henoch","also":"Hanoch","summary":"","verses":2,"father":"Midian","mother":"","v":[4]},{"id":"isaac_616","name":"Isaac","also":"","summary":"The only son of Abraham by Sarah. He was the longest lived of the three patriarchs (Gen. 21:1-3).","verses":123,"father":"Abraham","mother":"Sarah","v":[5,6,9,11,19,20,21,26,28]},{"id":"ishmael_630","name":"Ishmael","also":"","summary":"Abraham’s eldest son, by Hagar the concubine (Gen. 16:15; 17:23). He was born at Mamre, when Abraham was eighty-six years of age, eleven years after his arrival in Canaan (16:3; 21:5).","verses":18,"father":"Abraham","mother":"Hagar","v":[9,12,13,16,17]},{"id":"ephron_1208","name":"Ephron","also":"","summary":"The son of Zohar a Hittite, the owner of the field and cave of Machpelah, which Abraham bought for 400 shekels of silver (Gen. 23:8-17; 25:9; 49:29, 30).","verses":10,"father":"Zohar","mother":"","v":[9]},{"id":"zohar_3101","name":"Zohar","also":"","summary":"The father of Ephron the Hittite (Gen. 23:8).","verses":2,"father":"","mother":"","v":[9]},{"id":"sarah_2473","name":"Sarah","also":"Sarai, Sara","summary":"Princess, the wife and at the same time the half-sister of Abraham (Gen. 11:29; 20:12). This name was given to her at the time that it was announced to Abraham that she should be the mother of the promised child.","verses":48,"father":"Terah","mother":"","v":[10,12]},{"id":"heth_1510","name":"Heth","also":"","summary":"Dread, a descendant of Canaan, and the ancestor of the Hittites (Gen. 10:18; Deut. 7:1), who dwelt in the vicinity of Hebron (Gen. 23:3, 7).","verses":12,"father":"Canaan","mother":"","v":[10]},{"id":"hagar_1348","name":"Hagar","also":"Agar","summary":"Flight, or, according to others, stranger, an Egyptian, Sarah’s handmaid (Gen. 16:1; 21:9, 10), whom she gave to Abraham as a secondary wife (16:2).","verses":12,"father":"","mother":"","v":[12]},{"id":"kedar_1769","name":"Kedar","also":"","summary":"Dark-skinned, the second son of Ishmael (Gen. 25:13).","verses":10,"father":"Ishmael","mother":"","v":[13]},{"id":"nebajoth_2164","name":"Nebajoth","also":"Nebaioth","summary":"Ishmael’s eldest son (Gen. 25:13), and the prince of an Israelitish tribe (16).","verses":5,"father":"Ishmael","mother":"","v":[13]},{"id":"adbeel_79","name":"Adbeel","also":"","summary":"Miracle of God, the third of the twelve sons of Ishmael, and head of an Arabian tribe (Gen. 25:13; 1 Chr. 1:29).","verses":2,"father":"Ishmael","mother":"","v":[13]},{"id":"mibsam_2046","name":"Mibsam","also":"","summary":"One of Ishmael’s twelve sons, and head of an Arab tribe (Gen. 25:13).","verses":2,"father":"Ishmael","mother":"","v":[13]},{"id":"dumah_1025","name":"Dumah","also":"","summary":"","verses":2,"father":"Ishmael","mother":"","v":[14]},{"id":"massa_1945","name":"Massa","also":"","summary":"A lifting up, gift, one of the sons of Ishmael, the founder of an Arabian tribe (Gen. 25:14); a nomad tribe inhabiting the Arabian desert toward Babylonia.","verses":2,"father":"Ishmael","mother":"","v":[14]},{"id":"mishma_2094","name":"Mishma","also":"","summary":"One of the sons of Ishmael (Gen. 25:14), and founder of an Arab tribe.","verses":2,"father":"Ishmael","mother":"","v":[14]},{"id":"hadar_1341","name":"Hadar","also":"Hadad","summary":"A son of Ishmael (Gen. 25:15); in 1 Chr. 1:30 written Hadad.","verses":2,"father":"Ishmael","mother":"","v":[15]},{"id":"jetur_911","name":"Jetur","also":"","summary":"An enclosure, one of the twelve sons of Ishmael (Gen. 25:15).","verses":2,"father":"Ishmael","mother":"","v":[15]},{"id":"kedemah_1770","name":"Kedemah","also":"","summary":"Eastward, the last-named of the sons of Ishmael (Gen. 25:15).","verses":2,"father":"Ishmael","mother":"","v":[15]},{"id":"naphish_2148","name":"Naphish","also":"","summary":"","verses":2,"father":"Ishmael","mother":"","v":[15]},{"id":"tema_2837","name":"Tema","also":"","summary":"","verses":2,"father":"Ishmael","mother":"","v":[15]},{"id":"laban_1803","name":"Laban","also":"","summary":"The son of Bethuel, who was the son of Nahor, Abraham’s brother. He lived at Haran in Mesopotamia. His sister Rebekah was Isaac’s wife (Gen. 24).","verses":46,"father":"Bethuel","mother":"","v":[20]},{"id":"rebekah_2401","name":"Rebekah","also":"","summary":"A noose, the daughter of Bethuel, and the wife of Isaac (Gen. 22:23; 24:67). The circumstances under which Abraham’s “steward” found her at the “city of Nahor,” in Padan-aram, are narrated in Gen. 24-27.","verses":29,"father":"Bethuel","mother":"","v":[20,21,28]},{"id":"bethuel_487","name":"Bethuel","also":"","summary":"The son of Nahor by Milcah; nephew of Abraham, and father of Rebekah (Gen. 22:22, 23; 24:15, 24, 47).","verses":9,"father":"Nahor","mother":"Milcah","v":[20]},{"id":"esau_1216","name":"Esau","also":"Edom, Edomite","summary":"Hairy, Rebekah’s first-born twin son (Gen. 25:25). The name of Edom, “red”, was also given to him from his conduct in connection with the red lentil “pottage” for which he sold his birthright (30, 31).","verses":151,"father":"Isaac","mother":"Rebekah","v":[25,26,27,28,29,30,32,34]},{"id":"israel_682","name":"Israel","also":"","summary":"One who follows on another’s heels; supplanter, (Gen. 25:26; 27:36; Hos. 12:2-4), the second born of the twin sons of Isaac by Rebekah. He was born probably at Lahai-roi, when his father was fifty-nine and Abraham one hundred and fifty-nine years old.","verses":1009,"father":"Isaac","mother":"Rebekah","v":[26,27,28,29,30,31,33,34]}],"places":[{"id":"machpelah_748","name":"Machpelah","kind":"Landmark (Cave)","lat":31.52465,"lon":35.11073,"summary":"Portion; double cave, the cave which Abraham bought, together with the field in which it stood, from Ephron the Hittite, for a family burying-place (Gen. 23).","verses":6,"v":[9]},{"id":"mamre_762","name":"Mamre","kind":"","lat":31.5491,"lon":35.09356,"summary":"The name of the place in the neighbourhood of Hebron where Abraham dwelt (Gen. 23:17, 19; 35:27); called also in Authorized Version (13:18) the “plain of Mamre,” but in Revised Version more correctly “the oaks [marg., ‘terebinths’] of Mamre.”","verses":6,"v":[9]},{"id":"beer-lahai-roi_167","name":"Beer-lahai-roi","kind":"","lat":30.68771,"lon":34.4948,"summary":"I.e., “the well of him that liveth and seeth me,” or, as some render it, “the well of the vision of life”, the well where the Lord met with Hagar (Gen. 16:7-14).","verses":2,"v":[11]},{"id":"assyria_111","name":"Assyria","kind":"Region","lat":36.50969,"lon":43.2282,"summary":"The name derived from the city Asshur on the Tigris, the original capital of the country, was originally a colony from Babylonia, and was ruled by viceroys from that kingdom.","verses":116,"v":[18]},{"id":"egypt_362","name":"Egypt","kind":"Region (Country)","lat":26.4902,"lon":29.8808,"summary":"The land of the Nile and the pyramids, the oldest kingdom of which we have any record, holds a place of great significance in Scripture.","verses":564,"v":[18]},{"id":"havilah_534","name":"Havilah","kind":"Region","lat":30.14,"lon":35.22,"summary":"A district in Arabia-Felix. It is uncertain whether the tribe gave its name to this region or derived its name from it, and whether it was originally a Cushite (Gen. 10:7) or a Joktanite tribe (10:29; comp. 25:18), or whether there were both a Cushite and a Joktanite Havilah.","verses":2,"v":[18]},{"id":"shur_1090","name":"Shur","kind":"","lat":30.2354,"lon":33.247,"summary":"An enclosure; a wall, a part, probably, of the Arabian desert, on the north-eastern border of Egypt, giving its name to a wilderness extending from Egypt toward Philistia (Gen. 16:7; 20:1; 25:18; Ex. 15:22).","verses":6,"v":[18]},{"id":"paddan-aram_916","name":"Paddan-aram","kind":"","lat":36.86386,"lon":39.0322,"summary":"The plain of Aram, or the plain of the highlands, (Gen. 25:20; 28:2, 5-7; 31:18, etc.), commonly regarded as the district of Mesopotamia lying around Haran.","verses":10,"v":[20]}],"events":[{"id":"death_of_abraham_88","title":"Death of Abraham","year":-1821,"summary":"Passage: Genesis 25:7. People: Abraham. Place: Machpelah.","v":[7]},{"id":"lifetime_of_abraham_66","title":"Lifetime of Abraham","year":-1997,"summary":"Passage: Genesis 21:5–25:7. People: Abraham. Lasted about 175 years.","v":[7]},{"id":"death_of_ishmael_90","title":"Death of Ishmael","year":-1773,"summary":"Passage: Genesis 25:17. People: Ishmael.","v":[17]},{"id":"lifetime_of_ishmael_77","title":"Lifetime of Ishmael","year":-1910,"summary":"Passage: Genesis 16:16–25:17. People: Ishmael. Lasted about 137 years.","v":[17]},{"id":"isaac_marries_rebekah_83","title":"Isaac Marries Rebekah","year":-1856,"summary":"Passage: Genesis 25:20. People: Isaac, Rebekah.","v":[20]},{"id":"birth_of_jacob_and_esau_85","title":"Birth of Jacob and Esau","year":-1836,"summary":"Passage: Genesis 25:24–26. People: Esau, Israel, Rebekah, Isaac.","v":[24,25,26]},{"id":"lifetime_of_jacob_86","title":"Lifetime of Jacob","year":-1836,"summary":"Passage: Genesis 25:24–49:33. People: Israel. Lasted about 180 years.","v":[24,25,26]}],"traditions":[],"sources":["JFB","MHCC","Wesley"],"tags":{"bsb":[[85,85,3947,3947,3254,802,8034,6989],[3205,3205,3205,853,2175,3370,4091,4080,3435,7744,7744],[3370,3205,3205,3205,3205,7614,1719,1719,1121,1121,1121,1719,1719,1961,805,805,3912,3912,3817,3817,3817],[1121,1121,4080,4080,5891,5891,6081,2585,28,420,420,3605,428,1121,1121,6989,6989],[85,5414,3605,0,0,3327,3327],[5750,5750,5750,5750,5750,2416,85,5414,4979,1121,1121,1121,834,834,6370,7971,7971,7971,7971,5921,1121,1121,3327,413,776,776,6924,6924,6924],[85,2416,428,428,428,3967,8141],[2896,2896,2896,2896,7872,7872,1478,1478,1478,1478,4191,4191,2205,7649,7649,622,622,622,413,5971,5971],[1121,1121,3327,3458,3458,6912,853,413,4631,4631,4375,4375,5921,4471,413,7704,7704,6085,6085,1121,6714,6714,2850,2850],[7704,7704,7704,7704,834,85,7069,7069,1121,1121,1121,85,6912,6912,8033,802,802,802,8283],[310,85,4194,430,1288,1121,1121,3327,3327,3427,5973,883],[428,8435,8435,8435,85,85,1121,3458,834,1904,4713,4713,8283,8198,3205,85,85],[428,8034,8034,8034,1121,1121,1121,3458,3458,8435,8435,8435,8435,8435,8435,5032,1060,1060,3458,3458,6938,6938,110,4017],[4927,1746,4854],[2301,8485,3195,5305,6929,6929],[428,1992,1121,1121,3458,3458,428,428,8034,8034,8034,2691,2691,2691,2918,2918,5387,523,523,523],[3458,2416,428,428,428,3967,8141,1478,1478,1478,1478,1478,4191,4191,622,622,622,413,5971,5971],[7931,7931,7931,2341,2341,5704,7793,834,5921,5921,6440,6440,47