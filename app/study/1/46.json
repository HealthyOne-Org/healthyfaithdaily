],["עַתָּה","'atah","H6258","HD","now"],["גַּם","gam-","H1571","HD","both"],["אֲנַחְנוּ","'anachnu","H587","HPp1bp","we"],["גַּם","gam-","H1571","HD","as well as"],["אֲבֹתֵינוּ","'avoteinu","H1","HNcfpc/Sp1bp","fathers our"],["בַּעֲבוּר","ba'avur","H5668","HR/Ncmsa","in order that"],["תֵּשְׁבוּ","teshevu","H3427","HVqj2mp","you may dwell"],["בְּאֶרֶץ","be'eretz","H776","HR/Ncfsc","in [the] land of"],["גֹּשֶׁן","goshen","H1657","HNpl","Goshen"],["כִּי","ki-","H3588","HTc","for"],["תוֹעֲבַת","to'avat","H8441","HNcfsc","[is] [the] abomination of"],["מִצְרַיִם","mitzrayim","H4713","HNpl","Egypt"],["כָּל","kol-","H3605","HNcmsa","every"],["רֹעֵה","ro'eh","H7462","HVqrmsc","shepherd of"],["צֹאן","tzon","H6629","HNcbsa","sheep"]],"x":[[2008026,2008026,5],[1043032,1043032,4]],"xn":2}},"people":[{"id":"israel_682","name":"Israel","also":"","summary":"One who follows on another’s heels; supplanter, (Gen. 25:26; 27:36; Hos. 12:2-4), the second born of the twin sons of Isaac by Rebekah. He was born probably at Lahai-roi, when his father was fifty-nine and Abraham one hundred and fifty-nine years old.","verses":1009,"father":"Isaac","mother":"Rebekah","v":[1,2,5,6,8,15,18,19,22,25,26,27,29,30]},{"id":"isaac_616","name":"Isaac","also":"","summary":"The only son of Abraham by Sarah. He was the longest lived of the three patriarchs (Gen. 21:1-3).","verses":123,"father":"Abraham","mother":"Sarah","v":[1]},{"id":"joseph_1710","name":"Joseph","also":"Zaphnath-paaneah","summary":"The elder of the two sons of Jacob by Rachel (Gen. 30:23, 24), who, on the occasion of his birth, said, “God hath taken away [Heb. ‘asaph] my reproach.”","verses":199,"father":"Israel","mother":"Rachel","v":[4,19,20,27,28,29,30,31]},{"id":"pharaoh_2329","name":"Pharaoh","also":"","summary":"The Pharaoh of Joseph’s days (Gen. 41) was probably Apopi, or Apopis, the last of the Hyksos kings. To the old native Egyptians, who were an African race, shepherds were “an abomination;” but to the Hyksos kings these Asiatic shepherds who now appeared with Jacob at their head were congenial, and being akin to their own race, had a warm welcome (Gen. 47:5, 6).","verses":63,"father":"","mother":"","v":[5,31,33]},{"id":"canaan_914","name":"Canaan","also":"Canaanites, Canaanite","summary":"The fourth son of Ham (Gen. 10:6). His descendants were under a curse in consequence of the transgression of his father (9:22-27). His eldest son, Zidon, was the father of the Sidonians and Phoenicians.","verses":84,"father":"Ham","mother":"","v":[6,12,31]},{"id":"reuben_2429","name":"Reuben","also":"","summary":"Behold a son!, the eldest son of Jacob and Leah (Gen. 29:32). His sinful conduct, referred to in Gen. 35:22, brought down upon him his dying father’s malediction (48:4).","verses":70,"father":"Israel","mother":"Leah","v":[8,9]},{"id":"hezron_1519","name":"Hezron","also":"","summary":"One of the sons of Reuben (Gen. 46:9; Ex. 6:14).","verses":5,"father":"Reuben","mother":"","v":[9]},{"id":"pallu_2325","name":"Pallu","also":"Phallu","summary":"Separated, the second son of Reuben (1 Chr. 5:3); called Phallu, Gen. 46:9.","verses":5,"father":"Reuben","mother":"","v":[9]},{"id":"carmi_920","name":"Carmi","also":"","summary":"The last named of the four sons of Reuben (Gen. 46:9).","verses":4,"father":"Reuben","mother":"","v":[9]},{"id":"hanoch_1403","name":"Hanoch","also":"","summary":"","verses":4,"father":"Reuben","mother":"","v":[9]},{"id":"simeon_2741","name":"Simeon","also":"","summary":"The second son of Jacob by Leah (Gen. 29:33). He was associated with Levi in the terrible act of vengeance against Hamor and the Shechemites (34:25, 26).","verses":40,"father":"Israel","mother":"Leah","v":[10]},{"id":"jachin_679","name":"Jachin","also":"Jarib","summary":"The fourth son of Simeon (Gen. 46:10), called also Jarib (1 Chr. 4:24).","verses":4,"father":"Simeon","mother":"","v":[10]},{"id":"jamin_720","name":"Jamin","also":"","summary":"The Jaminite clan.","verses":4,"father":"Simeon","mother":"","v":[10]},{"id":"jemuel_838","name":"Jemuel","also":"Nemuel","summary":"One of Simeon’s five sons (1 Chr. 4:24), called also Jemuel (Gen. 46:10).","verses":4,"father":"Simeon","mother":"","v":[10]},{"id":"shaul_2562","name":"Shaul","also":"","summary":"Son of Simeon.","verses":4,"father":"Simeon","mother":"Canaanitish woman","v":[10]},{"id":"zerah_3102","name":"Zerah","also":"Zohar","summary":"One of the sons of Simeon (Gen. 46:10; Ex. 6:15).","verses":4,"father":"Simeon","mother":"","v":[10]},{"id":"canaanitish_woman_915","name":"Canaanitish woman","also":"","summary":"","verses":2,"father":"","mother":"","v":[10]},{"id":"ohad_2239","name":"Ohad","also":"","summary":"United, or power, the third son of Simeon (Gen. 46:10).","verses":2,"father":"Simeon","mother":"","v":[10]},{"id":"levi_1820","name":"Levi","also":"","summary":"The third son of Jacob by Leah. The origin of the name is found in Leah’s words (Gen. 29:34), “This time will my husband be joined [Heb. yillaveh] unto me.”","verses":64,"father":"Israel","mother":"Leah","v":[11]},{"id":"merari_2004","name":"Merari","also":"","summary":"Sad; bitter, the youngest son of Levi, born before the descent of Jacob into Egypt, and one of the seventy who accompanied him thither (Gen. 46:11; Ex. 6:16).","verses":38,"father":"Levi","mother":"","v":[11]},{"id":"kohath_1790","name":"Kohath","also":"","summary":"Assembly, the second son of Levi, and father of Amram (Gen. 46:11).","verses":29,"father":"Levi","mother":"","v":[11]},{"id":"gershon_1305","name":"Gershon","also":"Gershom","summary":"Ger’shom expulsion, the eldest of Levi’s three sons (Gen. 46:11; Ex. 6:16).","verses":25,"father":"Levi","mother":"","v":[11]},{"id":"judah_1751","name":"Judah","also":"","summary":"Praise, the fourth son of Jacob by Leah.","verses":245,"father":"Israel","mother":"Leah","v":[12,28]},{"id":"pharez_2338","name":"Pharez","also":"Phares, Perez","summary":"Pharez,, breach, the son of Judah (Neh. 11:4). “The chief of all the captains of the host for the first month” in the reign of David was taken from his family (1 Chr. 27:3).","verses":15,"father":"Judah","mother":"Tamar","v":[12]},{"id":"hezron_1520","name":"Hezron","also":"Esrom","summary":"The older of the two sons of Pharez (Gen. 46:12).","verses":13,"father":"Pharez","mother":"","v":[12]},{"id":"zerah_2984","name":"Zerah","also":"Zara, Zarah","summary":"A son of Tamar (Gen. 38:30); called also Zara (Matt. 1:3).","verses":12,"father":"Judah","mother":"Tamar","v":[12]},{"id":"shelah_2593","name":"Shelah","also":"","summary":"Judah’s third son (Gen. 38:2, 5, 11, 14).","verses":8,"father":"Judah","mother":"Daughter of Shuah","v":[12]},{"id":"er_1209","name":"Er","also":"","summary":"Birth.","verses":6,"father":"Judah","mother":"Daughter of Shuah","v":[12]},{"id":"onan_2250","name":"Onan","also":"","summary":"Strong, the second son of Judah (Gen. 38:4-10; comp. Deut. 25:5; Matt. 22:24).","verses":6,"father":"Judah","mother":"Daughter of Shuah","v":[12]},{"id":"hamul_1367","name":"Hamul","also":"","summary":"Spared, one of the sons of Pharez, son of Judah (1 Chr. 2:5).","verses":3,"father":"Pharez","mother":"","v":[12]},{"id":"issachar_645","name":"Issachar","also":"","summary":"Hired (Gen. 30:18). “God hath given me,” said Leah, “my hire (Heb. sekhari)...and she called his name Issachar.” He was Jacob’s ninth son, and was born in Padan-aram (comp. 28:2).","verses":38,"father":"Israel","mother":"Leah","v":[13]},{"id":"tola_2878","name":"Tola","also":"","summary":"Eldest son of Issachar (Gen. 46:13).","verses":4,"father":"Issachar","mother":"","v":[13]},{"id":"jashub_1638","name":"Jashub","also":"Job","summary":"The third of Issachar’s four sons (1 Chr. 7:1); called also Job (Gen. 46:13).","verses":3,"father":"Issachar","mother":"","v":[13]},{"id":"puah_2355","name":"Puah","also":"Phuvah","summary":"The sons of Issachar.","verses":3,"father":"Issachar","mother":"","v":[13]},{"id":"shimron_2706","name":"Shimron","also":"","summary":"Watchman, the fourth son of Issachar (Gen. 46:13; 1 Chr. 7:1; R.V., correctly, “Shimron”).","verses":3,"father":"Issachar","mother":"","v":[13]},{"id":"zebulun_3002","name":"Zebulun","also":"Zabulon","summary":"Dwelling, the sixth and youngest son of Jacob and Leah (Gen. 30:20). Little is known of his personal history.","verses":46,"father":"Israel","mother":"Leah","v":[14]},{"id":"elon_1183","name":"Elon","also":"","summary":"One of the sons of Zebulun (Gen. 46:14).","verses":2,"father":"Zebulun","mother":"","v":[14]},{"id":"jahleel_704","name":"Jahleel","also":"","summary":"","verses":2,"father":"Zebulun","mother":"","v":[14]},{"id":"sered_2501","name":"Sered","also":"","summary":"Fear, one of the sons of Zebulun (Gen. 46:14).","verses":2,"father":"Zebulun","mother":"","v":[14]},{"id":"leah_1813","name":"Leah","also":"","summary":"Weary, the eldest daughter of Laban, and sister of Rachel (Gen. 29:16). Jacob took her to wife through a deceit of her father (Gen. 29:23). She was “tender-eyed” (17).","verses":32,"father":"Laban","mother":"","v":[15,18]},{"id":"dinah_1012","name":"Dinah","also":"","summary":"Judged; vindicated, daughter of Jacob by Leah, and sister of Simeon and Levi (Gen. 30:21). She was seduced by Shechem, the son of Hamor, the Hivite chief, when Jacob’s camp was in the neighbourhood of Shechem.","verses":8,"father":"Israel","mother":"Leah","v":[15]},{"id":"gad_1262","name":"Gad","also":"","summary":"Jacob’s seventh son, by Zilpah, Leah’s handmaid, and the brother of Asher (Gen. 30:11-13; 46:16, 18).","verses":55,"father":"Israel","mother":"Zilpah","v":[16]},{"id":"areli_296","name":"Areli","also":"","summary":"","verses":2,"father":"Gad","mother":"","v":[16]},{"id":"arod_311","name":"Arod","also":"Arodi","summary":"","verses":2,"father":"Gad","mother":"","v":[16]},{"id":"eri_1214","name":"Eri","also":"","summary":"","verses":2,"father":"Gad","mother":"","v":[16]},{"id":"haggi_1351","name":"Haggi","also":"","summary":"","verses":2,"father":"Gad","mother":"","v":[16]},{"id":"o