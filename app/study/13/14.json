ses":5,"father":"David","mother":"Bathsheba","v":[4]},{"id":"shammua_2547","name":"Shammua","also":"Shimea","summary":"One of David’s sons by Bathsheba (1 Chr. 3:5); called also Shammua (14:4).","verses":3,"father":"David","mother":"Bathsheba","v":[4]},{"id":"shobab_2715","name":"Shobab","also":"","summary":"One of David’s sons by Bathseheba (2 Sam. 5:14).","verses":3,"father":"David","mother":"Bathsheba","v":[4]},{"id":"elishua_1163","name":"Elishua","also":"Elishama","summary":"God his salvation, a son of David, 2 Sam. 5:15 = Elishama, 1 Chr. 3:6.","verses":3,"father":"David","mother":"","v":[5]},{"id":"ibhar_1584","name":"Ibhar","also":"","summary":"Chosen, one of David’s sons (1 Chr. 3:6; 2 Sam. 5:15).","verses":3,"father":"David","mother":"","v":[5]},{"id":"elpalet_1148","name":"Elpalet","also":"Eliphelet","summary":"","verses":2,"father":"David","mother":"","v":[5]},{"id":"japhia_728","name":"Japhia","also":"","summary":"One of the sons of David (2 Sam. 5:15), born in Jerusalem.","verses":3,"father":"David","mother":"","v":[6]},{"id":"nepheg_2179","name":"Nepheg","also":"","summary":"Weak.","verses":3,"father":"David","mother":"","v":[6]},{"id":"nogah_2213","name":"Nogah","also":"","summary":"Splendour, one of David’s sons, born at Jerusalem (1 Chr. 3:7).","verses":2,"father":"David","mother":"","v":[6]},{"id":"eliada_1078","name":"Eliada","also":"Beeliada","summary":"One of David’s sons born after his establishment in Jerusalem (2 Sam. 5:16).","verses":3,"father":"David","mother":"","v":[7]},{"id":"eliphalet_1143","name":"Eliphalet","also":"Eliphelet","summary":"God his deliverance, one of David’s sons (2 Sam. 5:16); called also Eliphelet (1 Chr. 3:8).","verses":3,"father":"David","mother":"","v":[7]},{"id":"elishama_1156","name":"Elishama","also":"","summary":"One of David’s sons (2 Sam. 5:16).","verses":2,"father":"David","mother":"","v":[7]}],"places":[{"id":"tyre_1184","name":"Tyre","kind":"City","lat":33.26807,"lon":35.20936,"summary":"A rock, now es-Sur; an ancient Phoenician city, about 23 miles, in a direct line, north of Acre, and 20 south of Sidon. Sidon was the oldest Phoenician city, but Tyre had a longer and more illustrious history.","verses":52,"v":[1]},{"id":"jerusalem_636","name":"Jerusalem","kind":"City","lat":31.77667,"lon":35.23417,"summary":"Called also Salem, Ariel, Jebus, the “city of God,” the “holy city;” by the modern Arabs el-Khuds, meaning “the holy;” once “the city of Judah” (2 Chr. 25:28).","verses":754,"v":[3,4]},{"id":"valley_of_rephaim_1214","name":"valley of Rephaim","kind":"Valley","lat":31.75633,"lon":35.22306,"summary":"(Josh. 15:8; 18:16, R.V.). When David became king over all Israel, the Philistines, judging that he would now become their uncompromising enemy, made a sudden attack upon Hebron, compelling David to retire from it.","verses":8,"v":[9]},{"id":"baal-perazim_146","name":"Baal-perazim","kind":"","lat":31.75633,"lon":35.22306,"summary":"Baal having rents, bursts, or destructions, the scene of a victory gained by David over the Philistines (2 Sam. 5:20; 1 Chr. 14:11). Called Mount Perazim (Isa. 28:21).","verses":2,"v":[11]},{"id":"gezer_463","name":"Gezer","kind":"City","lat":31.85958,"lon":34.92048,"summary":"A precipice, an ancient royal Canaanitish city (Josh. 10:33; 12:12). It was allotted with its suburbs to the Kohathite Levites (21:21; 1 Chr. 6:67).","verses":14,"v":[16]},{"id":"gibeon_470","name":"Gibeon","kind":"City","lat":31.84668,"lon":35.1852,"summary":"Hill-city, “one of the royal cities, greater than Ai, and all the men thereof were mighty” (Josh. 10:2). Its inhabitants were Hivites (11:19).","verses":35,"v":[16]}],"events":[],"traditions":[],"sources":["JFB","MHCC"],"tags":{"bsb":[[2438,2438,4428,6865,6865,7971,4397,413,1732,730,730,730,6086,2796,2796,2796,1129,1129,1004,1004,0,0],[1732,1732,3045,3588,3068,3068,3559,3559,3559,4428,4428,5921,3478,3588,4605,4605,5375,4438,4438,5668,5668,5668,5971,5971,5971,3478],[1732,1732,3947,5750,802,3389,3389,1732,3205,320