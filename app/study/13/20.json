r":"","mother":"","v":[4]},{"id":"sippai_2471","name":"Sippai","also":"Saph","summary":"Extension, the son of the giant whom Sibbechai slew (2 Sam. 21:18); called also Sippai (1 Chr. 20:4).","verses":2,"father":"the giant in Gath","mother":"","v":[4]},{"id":"goliath_1327","name":"Goliath","also":"","summary":"A famous giant of Gath, who for forty days openly defied the armies of Israel, but was at length slain by David with a stone from a sling (1 Sam. 17:4).","verses":6,"father":"the giant in Gath","mother":"","v":[5]},{"id":"elhanan_1070","name":"Elhanan","also":"","summary":"A warrior of the time of David famed for his exploits. In the Authorized Version (2 Sam. 21:19) it is recorded that “Elhanan the son of Jaare-oregim, a Bethlehemite, slew the brother of Goliath.”","verses":2,"father":"Jair","mother":"","v":[5]},{"id":"jair_664","name":"Jair","also":"Jaare-oregim","summary":"The father of Elhanan, who slew Lahmi, the brother of Goliath (1 Chr. 20:5).","verses":2,"father":"","mother":"","v":[5]},{"id":"lahmi_1806","name":"Lahmi","also":"","summary":"","verses":1,"father":"the giant in Gath","mother":"","v":[5]},{"id":"man_of_great_stature_1924","name":"man of great stature","also":"","summary":"","verses":2,"father":"the giant in Gath","mother":"","v":[6]},{"id":"jonadab_1688","name":"Jonadab","also":"Jonathan","summary":"Son of Shammah, and David’s nephew, and also one of his chief warriors (2 Sam. 21:21).","verses":7,"father":"Shammah","mother":"","v":[7]}],"places":[{"id":"jerusalem_636","name":"Jerusalem","kind":"City","lat":31.77667,"lon":35.23417,"summary":"Called also Salem, Ariel, Jebus, the “city of God,” the “holy city;” by the modern Arabs el-Khuds, meaning “the holy;” once “the city of Judah” (2 Chr. 25:28).","verses":754,"v":[1,3]},{"id":"rabbah_966","name":"Rabbah","kind":"","lat":31.95522,"lon":35.94503,"summary":"“Rabbath of the children of Ammon,” the chief city of the Ammonites, among the eastern hills, some 20 miles east of the Jordan, on the