:11; Ex. 6:16).","verses":38,"father":"Levi","mother":"","v":[6,21]},{"id":"kohath_1790","name":"Kohath","also":"","summary":"Assembly, the second son of Levi, and father of Amram (Gen. 46:11).","verses":29,"father":"Levi","mother":"","v":[6,12]},{"id":"gershon_1305","name":"Gershon","also":"Gershom","summary":"Ger’shom expulsion, the eldest of Levi’s three sons (Gen. 46:11; Ex. 6:16).","verses":25,"father":"Levi","mother":"","v":[6]},{"id":"laadan_1823","name":"Laadan","also":"Libni, Jahath","summary":"White, one of the two sons of Gershon, the son of Levi (Ex. 6:17; Num. 3:18, 21).","verses":9,"father":"Gershon","mother":"","v":[7,8,9]},{"id":"shimei_2699","name":"Shimei","also":"Shimi","summary":"A son of Gershon.","verses":7,"father":"Gershon","mother":"","v":[7,9,10]},{"id":"jehiel_771","name":"Jehiel","also":"Jehieli","summary":"The sons of Ladan.","verses":4,"father":"","mother":"","v":[8]},{"id":"joel_1655","name":"Joel","also":"","summary":"Sons of Ladan.","verses":2,"father":"Jehiel","mother":"","v":[8]},{"id":"zetham_3056","name":"Zetham","also":"","summary":"Olive planter, a Levite (1 Chr. 23:8).","verses":2,"father":"Jehiel","mother":"","v":[8]},{"id":"haran_1409","name":"Haran","also":"","summary":"Sons of Shimei.","verses":1,"father":"","mother":"","v":[9]},{"id":"haziel_1467","name":"Haziel","also":"","summary":"","verses":1,"father":"","mother":"","v":[9]},{"id":"shelomith_2607","name":"Shelomith","also":"","summary":"","verses":1,"father":"","mother":"","v":[9]},{"id":"beriah_481","name":"Beriah","also":"","summary":"Son of Shimei.","verses":2,"father":"Shimei","mother":"","v":[10,11]},{"id":"jahath_692","name":"Jahath","also":"","summary":"A son of Shimei, and grandson of Gershom (1 Chr. 23:10).","verses":2,"father":"Shimei","mother":"","v":[10,11]},{"id":"jeush_1602","name":"Jeush","also":"","summary":"A Levite, one of the sons of Shimei (1 Chr. 23:10, 11).","verses":2,"father":"Shimei","mother":"","v":[10,11]},{"id":"zizah_3090","name":"Zizah","