,["אַהֲרֹן","'aharon","H175","HNpm","Aaron"],["לִפְנֵי","lifnei","H6440","HR/Ncmpc","<to> before"],["דָוִיד","david","H1732","HNpm","David"],["הַמֶּלֶךְ","hamelekh","H4428","HTd/Ncmsa","the king"],["וְצָדוֹק","vetzadok","H6659","HC/Npm","and Zadok"],["וַאֲחִימֶלֶךְ","va'achimelekh","H288","HC/Npm","and Ahimelech"],["וְרָאשֵׁי","verashei","H7218","HC/Ncmpc","and [the] heads of"],["הָאָבוֹת","ha'avot","H1","HTd/Ncfpa","the fathers"],["לַכֹּהֲנִים","lakohanim","H3548","HRd/Ncmpa","of the priests"],["וְלַלְוִיִּם","velalviyim","H3881","HC/Rd/Ngmpa","and of the Levites"],["אָבוֹת","'avot","H1","HNcfpa","fathers"],["הָרֹאשׁ","harosh","H7218","HTd/Ncmsa","the chief"],["לְעֻמַּת","le'umat","H5980","HR/Ncfsc","<to> corresponding to"],["אָחִיו","'achiv","H251","HNcmsc/Sp3ms","brother his"],["הַקָּטָן","hakatan","H6996","HTd/Aamsa","<the> young"]],"x":[[13024005,13024006,5],[13025008,13025008,3],[13026013,13026013,3]],"xn":3}},"people":[{"id":"aaron_1","name":"Aaron","also":"","summary":"The eldest son of Amram and Jochebed, a daughter of Levi (Ex. 6:20). Some explain the name as meaning mountaineer, others mountain of strength, illuminator.","verses":331,"father":"Amram","mother":"Jochebed","v":[1,19,31]},{"id":"eleazar_1062","name":"Eleazar","also":"","summary":"The third son of Aaron (Ex. 6:23). His wife, a daughter of Putiel, bore him Phinehas (Ex. 6:25). After the death of Nadab and Abihu (Lev. 10:12; Num. 3:4) he was appointed to the charge of the sanctuary (Num. 3:32).","verses":61,"father":"Aaron","mother":"Elisheba","v":[1,2,3,4,5,6]},{"id":"ithamar_649","name":"Ithamar","also":"","summary":"Palm isle, the fourth and youngest son of Aaron (1 Chr. 6:3). He was consecrated to the priesthood along with his brothers (Ex. 6:23); and after the death of Nadab and Abihu, he and Eleazar alone discharged the functions of that office (Lev. 10:6, 12; Num. 3:4).","verses":20,"father":"Aaron","mother":"Elisheba","v":[1,2,3,4,5,6]},{"id":"abihu_33","name":"Abihu","also":"","summary":"Father of Him; i.e., “worshipper of God”, the second of the sons of Aaron (Ex. 6:23; Num. 3:2; 26:60; 1 Chr. 6:3). Along with his three brothers he was consecrated to the priest’s office (Ex. 28:1).","verses":12,"father":"Aaron","mother":"Elisheba","v":[1,2]},{"id":"nadab_2128","name":"Nadab","also":"","summary":"The eldest of Aaron’s four sons (Ex. 6:23; Num. 3:2). He with his brothers and their father were consecrated as priests of Jehovah (Ex. 28:1).","verses":12,"father":"Aaron","mother":"Elisheba","v":[1,2]},{"id":"david_994","name":"David","also":"","summary":"Beloved, the eighth and youngest son of Jesse, a citizen of Bethlehem. His father seems to have been a man in humble life. His mother’s name is not recorded.","verses":896,"father":"Jesse","mother":"","v":[3,31]},{"id":"zadok_2973","name":"Zadok","also":"","summary":"A son of Ahitub, of the line of Eleazer (2 Sam. 8:17; 1 Chr. 24:3), high priest in the time of David (2 Sam. 20:25) and Solomon (1 Kings 4:4).","verses":40,"father":"Ahitub","mother":"","v":[3,6,31]},{"id":"ahimelech_149","name":"Ahimelech","also":"Abimelech","summary":"The son of Abiathar, and high priest in the time of David (1 Chr. 18:16). In the parallel passage, 2 Sam. 8:17, we have the name Ahimelech, and Abiathar, the son of Ahimelech.","verses":6,"father":"Abiathar","mother":"","v":[3,6,31]},{"id":"abiathar_20","name":"Abiathar","also":"","summary":"Father of abundance, or my father excels, the son of Ahimelech the high priest. He was the tenth high priest, and the fourth in descent from Eli.","verses":29,"father":"Ahimelech","mother":"","v":[6]},{"id":"nethaneel_2191","name":"Nethaneel","also":"","summary":"Father of The scribe Shemaiah.","verses":1,"father":"","mother":"","v":[6]},{"id":"shemaiah_2626","name":"Shemaiah","also":"","summary":"A Levite (1 Chr. 24:6).","verses":1,"father":"Nethaneel","mother":"","v":[6]},{"id":"jedaiah_753","name":"Jedaiah","also":"","summary":"Knowing Jehovah.","verses":3,"father":"","mother":"","v":[7]},{"id":"jehoiarib_798","name":"Jehoiarib","also":"","summary":"Jehovah defends, a priest at Jerusalem, head of one of the sacerdotal courses (1 Chr. 9:10; 24:7).","verses":1,"father":"","mother":"","v":[7]},{"id":"harim_1416","name":"Harim","also":"","summary":"The head of the second course of priests (1 Chr. 24:8).","verses":5,"father":"","mother":"","v":[8]},{"id":"seorim_2491","name":"Seorim","also":"","summary":"Barley, the chief of the forth priestly course (1 Chr. 24:8).","verses":1,"father":"","mother":"","v":[8]},{"id":"malchijah_1910","name":"Malchijah","also":"","summary":"The head of the fifth division of the priests in the time of David (1 Chr. 24:9).","verses":1,"father":"","mother":"","v":[9]},{"id":"mijamin_2076","name":"Mijamin","also":"","summary":"","verses":1,"father":"","mother":"","v":[9]},{"id":"abijah_36","name":"Abijah","also":"Abia","summary":"A descendant of Eleazar, the son of Aaron, a chief of one of the twenty-four orders into which the priesthood was divided by David (1 Chr. 24:10).","verses":2,"father":"","mother":"","v":[10]},{"id":"hakkoz_1355","name":"Hakkoz","also":"","summary":"The thorn, the head of one of the courses of the priests (1 Chr. 24:10).","verses":1,"father":"","mother":"","v":[10]},{"id":"jeshua_899","name":"Jeshua","also":"","summary":"Head of the ninth priestly order (Ezra 2:36); called also Jeshuah (1 Chr. 24:11).","verses":4,"father":"Jozadak","mother":"","v":[11]},{"id":"shecaniah_2581","name":"Shecaniah","also":"","summary":"A priest to whom the tenth lot came forth when David divided the priests (1 Chr. 24:11).","verses":1,"father":"","mother":"","v":[11]},{"id":"eliashib_1094","name":"Eliashib","also":"","summary":"A priest, head of one of the courses of the priests of the time of David (1 Chr. 24:12).","verses":1,"father":"","mother":"","v":[12]},{"id":"jakim_714","name":"Jakim","also":"","summary":"Chief of the twelfth priestly order (1 Chr. 24:12).","verses":1,"father":"","mother":"","v":[12]},{"id":"h