el"],["וַיִּבֶן","vaiyiven-","H1129","Hc/Vqw3ms","and he built"],["שָׁם","sham","H8033","HD","there"],["מִזְבֵּחַ","mizbeach","H4196","HNcmsa","an altar"],["לַיהוָה","layahweh","H3068","HR/Npt","to Yahweh"]],"x":[[9001019,9001019,5],[9001001,9001001,3],[9008004,9008004,3]],"xn":3}},"people":[{"id":"abinadab_43","name":"Abinadab","also":"","summary":"A Levite of Kirjath-jearim, in whose house the ark of the covenant was deposited after having been brought back from the land of the Philistines (1 Sam. 7:1).","verses":4,"father":"","mother":"","v":[1]},{"id":"eleazar_1063","name":"Eleazar","also":"","summary":"An inhabitant of Kirjath-jearim who was “sanctified” to take charge of the ark, although not allowed to touch it, while it remained in the house of his father Abinadab (1 Sam. 7:1, 2; comp. Num. 3:31; 4:15).","verses":1,"father":"Abinadab","mother":"","v":[1]},{"id":"samuel_2469","name":"Samuel","also":"Shemuel","summary":"Heard of God. The peculiar circumstances connected with his birth are recorded in 1 Sam. 1:20. Hannah, one of the two wives of Elkanah, who came up to Shiloh to worship before the Lord, earnestly prayed to God that she might become the mother of a son.","verses":122,"father":"Elkanah","mother":"Hannah","v":[3,5,6,8,9,10,12,13,15]},{"id":"israel_682","name":"Israel","also":"","summary":"One who follows on another’s heels; supplanter, (Gen. 25:26; 27:36; Hos. 12:2-4), the second born of the twin sons of Isaac by Rebekah. He was born probably at Lahai-roi, when his father was fifty-nine and Abraham one hundred and fifty-nine years old.","verses":1009,"father":"Isaac","mother":"Rebekah","v":[4,6,7,8]}],"places":[{"id":"kiriath-jearim_701","name":"Kiriath-jearim","kind":"City","lat":31.7711,"lon":34.99381,"summary":"City, a city belonging to Benjamin (Josh. 18:28), the modern Kuriet el-‘Enab, i.e., “city of grapes”, about 7 1/2 miles west-north-west of Jerusalem.","verses":15,"v":[1,2]},{"id":"mizpah_811","name":"Mizpah","kind":"City","lat":31.83274,"lon":35.18016,"summary":"A city of Benjamin, “the watch-tower”, where the people were accustomed to meet in great national emergencies (Josh. 18:26; Judg. 20:1, 3; 21:1, 5; 1 Sam. 7:5-16).","verses":30,"v":[5,6,7,11,12,16]},{"id":"beth-car_196","name":"Beth-car","kind":"","lat":31.83274,"lon":35.18016,"summary":"Sheep-house, a place to which the Israelites pursued the Philistines west from Mizpeh (1 Sam. 7:11).","verses":1,"v":[11]},{"id":"ebenezer_350","name":"Ebenezer","kind":"","lat":31.83274,"lon":35.18016,"summary":"Stone of help, the memorial stone set up by Samuel to commemorate the divine assistance to Israel in their great battle against the Philistines, whom they totally routed (1 Sam. 7:7-12) at Aphek, in the neighbourhood of Mizpeh, in Benjamin, near the western entrance of the pass of Beth-horon.","verses":3,"v":[12]},{"id":"shen_1072","name":"Shen","kind":"","lat":31.83274,"lon":35.18016,"summary":"A tooth, probably some conspicuous tooth-shaped rock or crag (1 Sam. 7:12), a place between which and Mizpeh Samuel set up his “Ebenezer.” In the Hebrew the word has the article prefixed, “the Shen.”","verses":1,"v":[12]},{"id":"ekron_364","name":"Ekron","kind":"City","lat":31.7776,"lon":34.85093,"summary":"Firm-rooted, the most northerly of the five towns belonging to the lords of the Philistines, about 11 miles north of Gath. It was assigned to Judah (Josh. 13:3), and afterwards to Dan (19:43), but came again into the full possession of the Philistines (1 Sam. 5:10).","verses":20,"v":[14]},{"id":"gath_442","name":"Gath","kind":"City","lat":31.69353,"lon":34.84388,"summary":"A wine-vat, one of the five royal cities of the Philistines (Josh. 13:3) on which the ark brought calamity (1 Sam. 5:8, 9; 6:17). It was famous also as being the birthplace or residence of Goliath (1 Sam. 17:4).","verses":32,"v":[14]},{"id":"bethel_202","name":"Bethel","kind":"","lat":31.93054,"lon":35.22103,"summary":"A place in Central Palestine, about 10 miles north of Jerusalem, at the head of the pass of Michmash and Ai. It was originally the royal Canaanite city of Luz (Gen. 28:19).","verses":62,"v":[16]},{"id":"gilgal_476","name":"Gilgal","kind":"City","lat":32.1547,"lon":34.95372,"summary":"From the solemn transaction of the reading of the law in the valley of Shechem between Ebal and Gerizim the Israelites moved forward to Gilgal, and there made a permanent camp (Josh. 9:6; 10:6).","verses":35,"v":[16]},{"id":"ramah_975","name":"Ramah","kind":"City","lat":32.0406,"lon":35.02158,"summary":"The same as Ramathaim-zophim, a town of Mount Ephraim (1 Sam. 1:1, 19).","verses":13,"v":[17]}],"events":[],"traditions":[],"sources":["JFB","MHCC","Wesley"],"tags":{"bsb":[[582,582,582,7157,7157,935,727,727,727,3068,3068,3068,5927,5927,853,413,41,1004,1389,1389,1389,853,6942,6942,1121,1121,499,8104,8104,727,727,3068,3068,3068],[3117,3117,3117,3117,7235,7235,3117,1961,6242,8141,1961,1961,727,727,727,3427,7157,7157,3605,3605,1004,1004,3478,3478,5091,310,3068,3068],[8050,8050,559,413,3605,1004,1004,3478,3478,518,859,7725,7725,413,3068,3068,3605,3605,3824,3824,5493,5493,5493,5236,5236,430,6252,6252,8432,8432,3559,3824,3824,413,3068,3068,5647,5647,5647,905,5337,5337,5337,5337,853,3027,3027,3027,6430,6430,6430],[1121,1121,1121,5493,5493,1168,1168,853,6252,5647,5647,905,3068,3068],[8050,8050,559,6908,3605,3478,4709,4709,6419,6419,6419,6419,413,3068,3068,1157,1157,1157],[6908,6908,6908,6908,4709,4709,7579,7579,4325,8210,8210,8210,8210,6440,3068,3068,1931,1931,3117,6684,6684,8033,8033,559,559,2398,2398,2398,3068,3068,3068,8050,8050,8199,1121,1121,4709,4709],[6430,6430,6430,8085,3588,1121,1121,6908,6908,4709,4709,6430,5633,5927,5927,413,3478,1121,1121,1121,1121,8085,8085,8085,3372,3372,6430,6430],[1121,559,413,8050,408,408,2790,2199,2199,413,3068,3068,430,430,4480,4480,3467,3467,3467,3467,3467,3027,3027,3027,6430,6430,6430],[8050,8050,3947,259,2461,2924,5927,5927,5927,3632,3632,3632,5930,5930,3068,3068,3068,8050,2199,2199,413,3068,3068,1157,1157,1157,3478,3068,