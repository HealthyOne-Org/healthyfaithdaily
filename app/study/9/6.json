dus.","verses":138,"father":"","mother":"","v":[6]},{"id":"joshua_1728","name":"Joshua","also":"","summary":"Israelite.","verses":2,"father":"","mother":"","v":[14,18]}],"places":[{"id":"beth-shemesh_234","name":"Beth-shemesh","kind":"City","lat":31.73072,"lon":34.99293,"summary":"A sacerdotal city in the tribe of Dan (Josh. 21:16; 1 Sam. 6:15), on the north border of Judah (Josh. 15:10). It was the scene of an encounter between Jehoash, king of Israel, and Amaziah, king of Judah, in which the latter was made prisoner (2 Kings 14:11, 13).","verses":17,"v":[9,12,13,14,15,18,19,20]},{"id":"ekron_364","name":"Ekron","kind":"City","lat":31.7776,"lon":34.85093,"summary":"Firm-rooted, the most northerly of the five towns belonging to the lords of the Philistines, about 11 miles north of Gath. It was assigned to Judah (Josh. 13:3), and afterwards to Dan (19:43), but came again into the full possession of the Philistines (1 Sam. 5:10).","verses":20,"v":[16,17]},{"id":"ashdod_101","name":"Ashdod","kind":"City","lat":31.75604,"lon":34.65606,"summary":"Stronghold, a Philistine city (Josh. 15:47), about midway between Gaza and Joppa, and 3 miles from the Mediterranean. It was one of the chief seats of the worship of Dagon (1 Sam. 5:5).","verses":19,"v":[17]},{"id":"ashkelon_103","name":"Ashkelon","kind":"City","lat":31.66426,"lon":34.54732,"summary":"Askelon=Ascalon, was one of the five cities of the Philistines (Josh. 13:3; 1 Sam. 6:17). It stood on the shore of the Mediterranean, 12 miles north of Gaza.","verses":11,"v":[17]},{"id":"gath_442","name":"Gath","kind":"City","lat":31.69353,"lon":34.84388,"summary":"A wine-vat, one of the five royal cities of the Philistines (Josh. 13:3) on which the ark brought calamity (1 Sam. 5:8, 9; 6:17). It was famous also as being the birthplace or residence of Goliath (1 Sam. 17:4).","verses":32,"v":[17]},{"id":"gaza_446","name":"Gaza","kind":"City","lat":31.50396,"lon":34.46203,"summary":"Called also Azzah, which is its Hebrew name (Deut. 