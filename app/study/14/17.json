in all"],["יְהוּדָה","yehudah","H3063","HNpl","Judah"]],"x":[[14017002,14017002,4]],"xn":1}},"people":[{"id":"jehoshaphat_808","name":"Jehoshaphat","also":"Josaphat","summary":"The son and successor of Asa, king of Judah. After fortifying his kingdom against Israel (2 Chr. 17:1, 2), he set himself to cleanse the land of idolatry (1 Kings 22:43).","verses":69,"father":"Asa","mother":"Azubah","v":[1,3,5,10,11,12]},{"id":"ephraim_1206","name":"Ephraim","also":"","summary":"Double fruitfulness (“for God had made him fruitful in the land of his affliction”). The second son of Joseph, born in Egypt (Gen. 41:52; 46:20).","verses":160,"father":"Joseph","mother":"Asenath","v":[2]},{"id":"asa_318","name":"Asa","also":"","summary":"Physician, son of Abijah and grandson of Rehoboam, was the third king of Judah. He was zealous in maintaining the true worship of God, and in rooting all idolatry, with its accompanying immoralities, out of the land (1 Kings 15:8-14).","verses":53,"father":"Abijah","mother":"","v":[2]},{"id":"david_994","name":"David","also":"","summary":"Beloved, the eighth and youngest son of Jesse, a citizen of Bethlehem. His father seems to have been a man in humble life. His mother’s name is not recorded.","verses":896,"father":"Jesse","mother":"","v":[3]},{"id":"benhail_455","name":"Benhail","also":"","summary":"","verses":1,"father":"","mother":"","v":[7]},{"id":"michaiah_2070","name":"Michaiah","also":"","summary":"One of those sent out by Jehoshaphat to instruct the people in the law (2 Chr. 17:7).","verses":1,"father":"","mother":"","v":[7]},{"id":"nethaneel_2193","name":"Nethaneel","also":"","summary":"One of the “princes” appointed by Jehoshaphat to teach the law through the cities of Judah (2 Chr. 17:7).","verses":1,"father":"","mother":"","v":[7]},{"id":"obadiah_2222","name":"Obadiah","also":"","summary":"One of the princes sent by Jehoshaphat to instruct the people in the law (2 Chr. 17:7).","verses":1,"father":"","mother":"","v":[7]},{"id":"zechariah_3008","name":"Zechariah","also":"","summary":"One who assisted in teaching the law to the people in the time of Jehoshaphat (2 Chr. 17:7).","verses":1,"father":"","mother":"","v":[7]},{"id":"adonijah_98","name":"Adonijah","also":"","summary":"A Levite sent with the princes to teach the book of the law to the inhabitants of Judah (2 Chr. 17:8).","verses":1,"father":"","mother":"","v":[8]},{"id":"asahel_321","name":"Asahel","also":"","summary":"A Levite.","verses":1,"father":"","mother":"","v":[8]},{"id":"elishama_1159","name":"Elishama","also":"","summary":"A priest sent by Jehoshaphat to teach the people the law (2 Chr. 17:8).","verses":1,"father":"","mother":"","v":[8]},{"id":"jehonathan_801","name":"Jehonathan","also":"","summary":"A Levite who taught the law to the people of Judah (2 Chr. 17:8).","verses":1,"father":"","mother":"","v":[8]},{"id":"jehoram_805","name":"Jehoram","also":"","summary":"A priest sent by Jehoshaphat to instructruct the people in Judah (2 Chr. 17:8).","verses":1,"father":"","mother":"","v":[8]},{"id":"nethaniah_2200","name":"Nethaniah","also":"","summary":"A Levite sent by Jehoshaphat to teach the law (2 Chr. 17:8).","verses":1,"father":"","mother":"","v":[8]},{"id":"shemaiah_2628","name":"Shemaiah","also":"","summary":"One of the Levites whom Jehoshaphat appointed to teach the law (2 Chr. 17:8).","verses":1,"father":"","mother":"","v":[8]},{"id":"shemiramoth_2652","name":"Shemiramoth","also":"","summary":"A Levite in the reign of Jehoshaphat (2 Chr. 17:8).","verses":1,"father":"","mother":"","v":[8]},{"id":"tobadonijah_2870","name":"Tobadonijah","also":"","summary":"Good is Jehovah, my Lord, a Levite sent out by Jehoshaphat to instruct the people of Judah in the law (2 Chr. 17:8).","verses":1,"father":"","mother":"","v":[8]},{"id":"tobijah_2873","name":"Tobijah","also":"","summary":"Id., a Levite sent out through Judah by Jehoshaphat to teach the people (2 Chr. 17:8).","verses":1,"father":"","mother":"","v":[8]},{"id":"zebadiah_2993","n