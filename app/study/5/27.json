["יָקִים","yakim","H6965","HVhi3ms","he will carry out"],["אֶת","'et-","H853","HTo","<obj.>"],["דִּבְרֵי","divrei","H1697","HNcmpc","[the] words of"],["הַתּוֹרָה","hatorah-","H8451","HTd/Ncfsa","the law"],["הַזֹּאת","hazot","H2063","HTd/Tm","<the> this"],["לַעֲשׂוֹת","la'asot","H6213","HR/Vqcc","by observing"],["אוֹתָם","'otam","H853","HTo/Sp3mp","<obj.> them"],["וְאָמַר","ve'amar","H559","Hc/Vqq3ms","and it will say"],["כָּל","kol-","H3605","HNcmsc","all"],["הָעָם","ha'am","H5971","HTd/Ncmsa","the people"],["אָמֵן","'amen","H543","HTj","amen"]],"x":[[48003010,48003010,12],[5028015,5028068,5],[45010005,45010005,4],[19119021,19119021,3],[26018024,26018024,3]],"xn":5}},"people":[{"id":"moses_2108","name":"Moses","also":"","summary":"Drawn (or Egypt. mesu, “son;” hence Rameses, royal son). On the invitation of Pharaoh (Gen. 45:17-25), Jacob and his sons went down into Egypt.","verses":774,"father":"Amram","mother":"Jochebed","v":[1,9,11]},{"id":"judah_1751","name":"Judah","also":"","summary":"Praise, the fourth son of Jacob by Leah.","verses":245,"father":"Israel","mother":"Leah","v":[12]},{"id":"joseph_1710","name":"Joseph","also":"Zaphnath-paaneah","summary":"The elder of the two sons of Jacob by Rachel (Gen. 30:23, 24), who, on the occasion of his birth, said, “God hath taken away [Heb. ‘asaph] my reproach.”","verses":199,"father":"Israel","mother":"Rachel","v":[12]},{"id":"benjamin_463","name":"Benjamin","also":"Ben-oni","summary":"The younger son of Jacob by Rachel (Gen. 35:18). His birth took place at Ephrath, on the road between Bethel and Bethlehem, at a short distance from the latter place.","verses":157,"father":"Israel","mother":"Rachel","v":[12]},{"id":"levi_1820","name":"Levi","also":"","summary":"The third son of Jacob by Leah. The origin of the name is found in Leah’s words (Gen. 29:34), “This time will my husband be joined [Heb. yillaveh] unto me.”","verses":64,"father":"Israel","mother":"Leah","v":[12]},{"id":"simeon_2741","name":"Simeon","also":"","summary":"The second son of Jacob by Leah (Gen. 29:33). He was associated with Levi in the terrible act of vengeance against Hamor and the Shechemites (34:25, 26).","verses":40,"father":"Israel","mother":"Leah","v":[12]},{"id":"issachar_645","name":"Issachar","also":"","summary":"Hired (Gen. 30:18). “God hath given me,” said Leah, “my hire (Heb. sekhari)...and she called his name Issachar.” He was Jacob’s ninth son, and was born in Padan-aram (comp. 28:2).","verses":38,"father":"Israel","mother":"Leah","v":[12]},{"id":"reuben_2429","name":"Reuben","also":"","summary":"Behold a son!, the eldest son of Jacob and Leah (Gen. 29:32). His sinful conduct, referred to in Gen. 35:22, brought down upon him his dying father’s malediction (48:4).","verses":70,"father":"Israel","mother":"Leah","v":[13]},{"id":"dan_973","name":"Dan","also":"","summary":"The fifth son of Jacob. His mother was Bilhah, Rachel’s maid (Gen. 30:6, “God hath judged me”, Heb. dananni).","verses":63,"father":"Israel","mother":"Bilhah","v":[13]},{"id":"gad_1262","name":"Gad","also":"","summary":"Jacob’s seventh son, by Zilpah, Leah’s handmaid, and the brother of Asher (Gen. 30:11-13; 46:16, 18).","verses":55,"father":"Israel","mother":"Zilpah","v":[13]},{"id":"naphtali_2149","name":"Naphtali","also":"Nephthalim","summary":"My wrestling, the fifth son of Jacob. His mother was Bilhah, Rachel’s handmaid (Gen. 30:8). When Jacob went down into Egypt, Naphtali had four sons (Gen. 46:24).","verses":49,"father":"Israel","mother":"Bilhah","v":[13]},{"id":"zebulun_3002","name":"Zebulun","also":"Zabulon","summary":"Dwelling, the sixth and youngest son of Jacob and Leah (Gen. 30:20). Little is known of his personal history.","verses":46,"father":"Israel","mother":"Leah","v":[13]},{"id":"asher_337","name":"Asher","also":"Aser","summary":"Happy, Jacob’s eigth son; his mother was Zilpah, Leah’s handmaid (Gen. 30:13). Of the tribe founded by him nothing is recorded beyond its holding a place in the list of the tribes (35:26; 46:17; Ex. 1:4, etc.) It increased in numbers twenty-nine percent, during the thirty-eight years’ wanderings.","verses":43,"father":"Israel","mother":"Zilpah","v":[13]}],"places":[{"id":"jordan_653","name":"Jordan","kind":"Water (River)","lat":33.18645,"lon":35.61916,"summary":"But besides these two historical fountains there is a third, called the Hasbany, which rises in the bottom of a valley at the western base of Hermon, 12 miles north of Tell-el-Kady.","verses":177,"v":[2,4,12]},{"id":"mount_ebal_832","name":"mount Ebal","kind":"Mountain","lat":32.23294,"lon":35.27304,"summary":"A mountain 3,076 feet above the level of the sea, and 1,200 feet above the level of the valley, on the north side of which stood the city of Shechem.","verses":5,"v":[4,13]},{"id":"mount_gerizim_836","name":"mount Gerizim","kind":"Mountain","lat":32.19956,"lon":35.27285,"summary":"A mountain of Samaria, about 3,000 feet above the Mediterranean. It was on the left of the valley containing the ancient town of Shechem, on the way to Jerusalem.","verses":4,"v":[12]}],"events":[],"traditions":[],"sources":["JFB","MHCC","Wesley"],"tags":{"bsb":[[4872,4872,2205,2205,2205,3478,3478,6680,5971,5971,8104,3605,4687,4687,595,6680,6680,853,3117],[1961,3117,3117,3117,5674,5674,3383,3383,413,776,776,834,3068,3068,430,430,5414,5414,0,6965,6965,1419,68,7874,7874,853,7875,7875],[3789,5921,5921,3605,1697,1697,2063,2063,8451,5674,5674,5674,5674,5674,4616,935,776,776,834,3068,3068,430,430,5414,5414,0,776,776,2100,2461,2461,1706,1706,834,834,3068,3068,430,430,1,1,1,1696,1696,1696],[1961,5674,5674,5674,5674,3383,3383,6965,6965,6965,6965,6965,428,68,2022,2022,5858,834,595,6680,6680,6680,6680,7874,7874,7874,7874,7874,853,7875,7875],[1129,1129,1129,1129,1129,8033,4196,4196,3068,3068,3068,430,430,4196,4196,4196,68,3808,3808,3808,5130,1270,1270,1270,5921,5921],[1129,1129,1129,4196,4196,3068,3068,3068,430,430,8003,8003,68,5927,5927,5921,5921,5930,5930,3068,3068,3068,430,430],[8033,2076,2076,2076,2076,8002,8002,800