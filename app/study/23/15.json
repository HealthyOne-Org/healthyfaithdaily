"וְלִשְׁאֵרִית","velish'erit","H7611","HC/R/Ncfsc","and for [the] remainder of"],["אֲדָמָה","'adamah","H127","HNcfsa","[the] land"]],"x":[[12017025,12017025,5]],"xn":1}},"people":[{"id":"moab_2103","name":"Moab","also":"Moabitess, Moabitish, Moabites","summary":"Used to denote the people of Moab (Num. 22:3-14; Judg. 3:30; 2 Sam. 8:2; Jer. 48:11, 13).","verses":149,"father":"Lot","mother":"Daughter of Lot - Older","v":[1,2,4,5,8,9]}],"places":[{"id":"ar_77","name":"Ar","kind":"","lat":31.44981,"lon":35.59396,"summary":"","verses":6,"v":[1]},{"id":"kir_693","name":"Kir","kind":"","lat":31.18133,"lon":35.70215,"summary":"A wall or fortress, a place to which Tiglath-pileser carried the Syrians captive after he had taken the city of Damascus (2 Kings 16:9; Amos 1:5; 9:7).","verses":5,"v":[1]},{"id":"moab_815","name":"Moab","kind":"Region (Country)","lat":31.49916,"lon":35.78051,"summary":"The land of Moab (Jer. 48:24), called also the “country of Moab” (Ruth 1:2, 6; 2:6), on the east of Jordan and the Dead Sea, and south of the Arnon (Num. 21:13, 26).","verses":148,"v":[1,2,4,5,8,9]},{"id":"dibon_331","name":"Dibon","kind":"City","lat":31.49916,"lon":35.78051,"summary":"A city in Moab (Num. 21:30); called also Dibon-gad (33:45), because it was built by Gad and Dimon (Isa. 15:9).","verses":9,"v":[2,9]},{"id":"medeba_775","name":"Medeba","kind":"City","lat":31.72046,"lon":35.79197,"summary":"Waters of quiet, an ancient Moabite town (Num. 21:30). It was assigned to the tribe of Reuben (Josh. 13:16). Here was fought the great battle in which Joab defeated the Ammonites and their allies (1 Chr. 19:7-15; comp. 2 Sam. 10:6-14).","verses":5,"v":[2]},{"id":"nebo_883","name":"Nebo","kind":"Church","lat":31.76772,"lon":35.72618,"summary":"A Chaldean god whose worship was introduced into Assyria by Pul (Isa. 46:1; Jer. 48:1). To this idol was dedicated the great temple whose ruins are still seen at Birs Nimrud.","verses":7,"v":[2]},{"id":"elealeh_368","name":"Elealeh","kind":"Settlement","lat":31.8138,"lon":35.82428,"summary":"God has ascended, a place in the pastoral country east of Jordan, in the tribe of Reuben (Num. 32:3, 37). It is not again mentioned till the time of Isaiah (15:4; 16:9) and Jeremiah (48:34).","verses":5,"v":[4]},{"id":"heshbon_565","name":"Heshbon","kind":"City","lat":31.79819,"lon":35.80986,"summary":"Intelligence, a city ruled over by Sihon, king of the Amorites (Josh. 3:10; 13:17). It was taken by Moses (Num. 21:23-26), and became afterwards a Levitical city (Josh. 21:39) in the tribe of Reuben (Num. 32:37).","verses":37,"v":[4]},{"id":"jahaz_617","name":"Jahaz","kind":"City","lat":31.501,"lon":35.92063,"summary":"Trodden down (called also Jahaza, Josh. 13:18; Jahazah, 21:36; Jahzah, 1 Chr. 6:78), a town where Sihon was defeated, in the borders of Moab and in the land of the Ammonites beyond Jordan, and north of the river Arnon (Num. 21:23; Deut. 2:32).","verses":5,"v":[4]},{"id":"eglath-shelishiyah_360","name":"Eglath-shelishiyah","kind":"","lat":null,"lon":null,"summary":"Heb. ‘eglah, (Deut. 21:4, 6; Jer. 46:20).","verses":2,"v":[5]},{"id":"horonaim_581","name":"Horonaim","kind":"City","lat":31.28806,"lon":35.515,"summary":"Two caverns, a city of Moab to the south of the Arnon, built, apparently, upon an eminence, and a place of some importance (Isa. 15:5; Jer. 48:3, 5, 34).","verses":4,"v":[5]},{"id":"luhith_736","name":"Luhith","kind":"Unlocated","lat":31.28806,"lon":35.515,"summary":"Made of boards, a Moabitish place between Zoar and Horonaim (Isa. 15:5; Jer. 48:5).","verses":2,"v":[5]},{"id":"zoar_1271","name":"Zoar","kind":"City","lat":30.92652,"lon":35.41906,"summary":"Small, a town on the east or south-east of the Dead Sea, to which Lot and his daughters fled from Sodom (Gen. 19:22, 23). It was originally called Bela (14:2, 8).","verses":9,"v":[5]},{"id":"nimrim_897","name":"Nimrim","kind":"Water (River)","lat":31.13319,"lon":35.53114,"summary":"The stream of the leopards, a stream in Moab (Isa. 15:6; Jer. 48:34); probably the modern Wady en-Nemeirah, a rich, verdant spot at the south-eastern end of the Dead Sea.","verses":2,"v":[6]},{"id":"willows_261","name":"Willows","kind":"","lat":32.3091,"lon":35.5599,"summary":"","verses":1,"v":[7]},{"id":"beer-elim_166","name":"Beer-elim","kind":"","lat":30.99806,"lon":35.49855,"summary":"Well of heroes, probably the name given to Beer, the place where the chiefs of Israel dug a well (Num. 21:16; Isa. 15:8).","verses":1,"v":[8]},{"id":"eglaim_359","name":"Eglaim","kind":"","lat":30.99806,"lon":35.49855,"summary":"Two ponds, (Isa. 15:8), probably En-eglaim of Ezek. 47:10.","verses":1,"v":[8]}],"events":[{"id":"prophecies_of_isaiah_217","title":"Prophecies of Isaiah","year":-759,"summary":"Passage: Isaiah 1:1–66:24. People: Isaiah. Lasted about 62 years.","v":[1,2,3,4,5,6,7,8,9]}],"traditions":[],"sources":["JFB","MHCC","Wesley"],"tags":{"bsb":[[4853,4853,4853,4853,4124,4124,6144,4124,4124,7703,7703,1820,3915,3915,3915,7024,4124,4124,7703,7703,1820,3915,3915,3915],[1769,5927,5927,1004,1004,1004,1065,1065,1116,1116,1116,1116,4124,3213,5921,5015,5921,5921,5921,5921,4311,3605,7218,7144,7144,3605,2206,1639,1639,1639],[2351,2351,2351,2296,2296,8242,5921,1406,1406,7339,7339,7339,7339,7339,3605,3605,3213,3381,3381,1065],[2809,500,500,2199,2199,6963,6963,8085,8085,5704,5704,5704,3096,5921,2502,2502,4124,4124,7321,7321,5315,5315,3415,0],[3820,3820,2199,2199,4124,4124,1281,1281,5704,5704,6820,6820,6820,5697,5697,5697,5697,1065,1065,5927,5927,4608,4608,3872,3872,5782,5782,7667,7667,1870,1870,1870,2773,2773],[4325,4325,5249,5249,1961,4923,4923,2682,2682,2682,3001,3001,1877,1877,3615,3615,3418,3418,3418,1961,3808,3808],[5921,5375,5375,3502,3502,6486,6486,5921,5158,5158,6155,6155,6155],[3588,2201,2201,5362,1366,1366,1366,4124,4124,3215,3215,97,97,3215,3215,3215,879,879],[4325,4325,1775,1775,4390,4390,4390,1818,3588,7896,7896,7896,3254,5921,1775,738,6413,6413,6413,4124,4124,7611,7611,7611,7611,127,127,127]],"kjv":[[4853,4853,4124,4124,3915,3915,