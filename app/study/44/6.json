:[5]},{"id":"prochorus_2371","name":"Prochorus","also":"","summary":"","verses":1,"father":"","mother":"","v":[5]},{"id":"timon_2862","name":"Timon","also":"","summary":"Honouring, one of the seven deacons at Jerusalem (Acts 6:5).","verses":1,"father":"","mother":"","v":[5]},{"id":"moses_2108","name":"Moses","also":"","summary":"Drawn (or Egypt. mesu, “son;” hence Rameses, royal son). On the invitation of Pharaoh (Gen. 45:17-25), Jacob and his sons went down into Egypt.","verses":774,"father":"Amram","mother":"Jochebed","v":[11,14]},{"id":"jesus_905","name":"Jesus","also":"Immanuel, Emmanuel, Messiah, Shiloh, Christ, Jesus Christ, Messias","summary":"Anointed, the Greek translation of the Hebrew word rendered “Messiah”, the official title of our Lord, occurring five hundred and fourteen times in the New Testament.","verses":1831,"father":"Joseph","mother":"Mary","v":[14]}],"places":[{"id":"antioch_68","name":"Antioch (Syria)","kind":"City","lat":36.20066,"lon":36.16532,"summary":"In Syria, on the river Orontes, about 16 miles from the Mediterranean, and some 300 miles north of Jerusalem. It was the metropolis of Syria, and afterwards became the capital of the Roman province in Asia.","verses":14,"v":[5]},{"id":"jerusalem_636","name":"Jerusalem","kind":"City","lat":31.77667,"lon":35.23417,"summary":"Called also Salem, Ariel, Jebus, the “city of God,” the “holy city;” by the modern Arabs el-Khuds, meaning “the holy;” once “the city of Judah” (2 Chr. 25:28).","verses":754,"v":[7]},{"id":"asia_108","name":"Asia","kind":"Region","lat":39.64015,"lon":31.03325,"summary":"Is used to denote Proconsular Asia, a Roman province which embraced the western parts of Asia Minor, and of which Ephesus was the capital, in Acts 2:9; 6:9; 16:6; 19:10, 22; 20:4, 16, 18, etc., and probably Asia Minor in Acts 19:26, 27; 21:27; 24:18; 27:2.","verses":18,"v":[9]},{"id":"cilicia_300","name":"Cilicia","kind":"Region","lat":36.91803,"lon":34.89153,"summary":"A maritime province in the south-east of Asia Minor. Tarsus, the birth-place of Paul, was one of its chief towns, and the seat of a celebrated school of philosophy.","verses":8,"v":[9]},{"id":"nazareth_878","name":"Nazareth","kind":"City","lat":32.70103,"lon":35.30015,"summary":"Separated, generally supposed to be the Greek form of the Hebrew netser, a “shoot” or “sprout.”","verses":28,"v":[14]}],"events":[{"id":"seven_chosen_to_serve_319","title":"Seven chosen to serve","year":30,"summary":"Passage: Acts 6:1–7. People: Nicolas, Parmenas, Timon, Nicanor, Prochorus, Philip and others. Place: Jerusalem.","v":[1,2,3,4,5,6,7]},{"id":"stephen_is_seized_320","title":"Stephen is seized","year":30,"summary":"Passage: Acts 6:8–15. People: Stephen. Place: Jerusalem.","v":[8,9,10,11,12,13,14,15]}],"traditions":[],"sources":["Barnes","JFB","MHCC","Wesley"],"tags":{"bsb":[[1722,3778,2250,2250,3588,3101,4129,4129,4129,4129,3588,1675,1675,1675,1675,1096,1112,1112,4314,3588,1445,1445,3754,846,5503,3865,3865,3865,1722,3588,2522,1248,1248,1248],[1161,3588,1427,4341,4128,3588,3101,2036,2036,1510,1510,701,1473,1473,2641,2641,3588,3056,2316,2316,1247,1247,1247,1247,1247,5132],[1161,80,1980,1537,4771,4771,2033,435,3140,3140,3140,4134,4151,4151,4151,2532,4678,2525,2525,2525,3778,5532,3739,3739],[1161,4342,4342,4342,3588,4335,2532,3588,3588,1248,3588,3588,3056],[3588,3056,700,3588,3956,4128,1586,1586,4736,435,435,4134,4102,4102,2532,40,40,40,4151,2532,2532,2532,5376,4402,3527,5096,3937,2532,3532,491,491,4339,4339,4339,4339],[2476,2476,3739,3739,1799,3588,652,2532,4336,2007,2007,3588,5495,846,846],[2532,3588,3056,2316,2316,837,837,837,3588,706,3588,3101,1722,2419,4129,4970,5037,4183,4183,3793,3588,2409,5219,5219,3588,3588,4102],[1161,4736,4134,4134,4134,5485,5485,2532,1411,4160,4160,3173,5059,2532,4592,1722,3588,2992],[1161,450,450,1537,3588,3004,3004,4864,4864,3588,3588,3032,2532,2956,221,2532,3588,575,2791,2791,2791,2791,2532,773,4802,4802,3588,4736],[2532,2480,2480,2480,436,436,436,3588,4678,2532,3588,4151,3739,3739,2980,2